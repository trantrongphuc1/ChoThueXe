@using ChoThueXe.Models.Portal
@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard - Khách hàng | ChoThueXe";
    var selectedAmenitiesText = Model.SelectedAmenityCodes.Any()
        ? string.Join(", ", Model.AmenityOptions
            .Where(x => Model.SelectedAmenityCodes.Contains(x.Code, StringComparer.OrdinalIgnoreCase))
            .Select(x => x.Name))
        : "Tất cả tiện nghi";
}

<style>
    :root {
        --bg-primary: #0f1117;
        --bg-secondary: #161b27;
        --bg-tertiary: #21262d;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --border: #30363d;
        --text-primary: #e2e8f0;
        --text-secondary: #8b949e;
        --success: #3fb950;
        --error: #f85149;
        --warning: #d29922;
        --info: #58a6ff;
        --radius: 8px;
        --radius-sm: 4px;
        --transition: all 0.2s ease;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
        margin-bottom: 24px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border);
    }

    .card-header h2 {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background-color: var(--bg-primary);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 20px;
        text-align: center;
        transition: var(--transition);
    }

    .stat-card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: var(--accent);
    }

    .stat-label {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: var(--radius-sm);
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
    }

    .btn-primary {
        background-color: var(--accent);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
    }

    .btn-secondary {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

    .btn-secondary:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-pending {
        background-color: rgba(217, 119, 6, 0.15);
        color: #d97706;
    }

    .badge-approved {
        background-color: rgba(34, 197, 94, 0.15);
        color: var(--success);
    }

    .badge-completed {
        background-color: rgba(6, 182, 212, 0.15);
        color: #06b6d4;
    }

    .badge-rejected {
        background-color: rgba(239, 68, 68, 0.15);
        color: var(--error);
    }

    .alert {
        padding: 12px 16px;
        border-radius: var(--radius-sm);
        margin-bottom: 16px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-success {
        background-color: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        color: var(--success);
    }

    .alert-error {
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: var(--error);
    }

    .alert-info {
        background-color: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: var(--accent);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    th {
        background-color: var(--bg-primary);
        padding: 12px;
        text-align: left;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border);
    }

    td {
        padding: 12px;
        border-bottom: 1px solid var(--border);
        color: var(--text-secondary);
    }

    tr:hover {
        background-color: var(--bg-primary);
    }

    .table-responsive {
        overflow-x: auto;
    }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
        }

        .search-strip {
            display: grid;
            grid-template-columns: 2fr 1.8fr 1.5fr auto;
            gap: 8px;
            padding: 8px;
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 14px;
            background: linear-gradient(120deg, rgba(59, 130, 246, 0.08), rgba(6, 182, 212, 0.05));
        }

        .search-cell {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .search-cell-label {
            font-size: 11px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .35px;
            font-weight: 600;
        }

        .search-cell input,
        .search-cell select {
            border: none;
            background: transparent;
            padding: 0;
            color: var(--text-primary);
            font-size: 15px;
            box-shadow: none;
        }

        .search-cell input:focus,
        .search-cell select:focus {
            border: none;
            box-shadow: none;
        }

        .search-submit {
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            color: #fff;
            font-size: 18px;
            font-weight: 700;
            padding: 0 20px;
            cursor: pointer;
            min-height: 84px;
        }

        .search-submit:hover {
            filter: brightness(1.08);
        }

        .amenity-checkbox-grid {
            margin-top: 12px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 8px;
        }

        .amenity-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--bg-primary);
            color: var(--text-primary);
            font-size: 13px;
        }

        .amenity-open-btn {
            width: 100%;
            border: none;
            background: transparent;
            color: var(--text-primary);
            font-size: 15px;
            text-align: left;
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .amenity-count-badge {
            border-radius: 999px;
            border: 1px solid rgba(59, 130, 246, 0.45);
            background: rgba(59, 130, 246, 0.2);
            color: #bfdbfe;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            white-space: nowrap;
            display: none;
        }

        .date-range-btn {
            width: 100%;
            border: none;
            background: transparent;
            color: var(--text-primary);
            font-size: 15px;
            text-align: left;
            padding: 0;
            cursor: pointer;
        }

        .amenity-modal {
            position: fixed;
            inset: 0;
            background: rgba(2, 6, 23, 0.72);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1100;
            padding: 16px;
        }

        .amenity-modal.show {
            display: flex;
        }

        .amenity-modal-card {
            width: min(720px, 100%);
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--bg-secondary);
            overflow: hidden;
        }

        .amenity-modal-head {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .amenity-modal-body {
            padding: 14px 16px;
            display: grid;
            gap: 12px;
        }

        .amenity-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            border-top: 1px solid var(--border);
            padding: 12px 16px;
        }

        .date-range-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(180px, 1fr));
            gap: 10px;
        }

        .date-range-summary {
            display: grid;
            grid-template-columns: repeat(2, minmax(140px, 1fr));
            gap: 10px;
            margin-bottom: 8px;
        }

        .date-point {
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--bg-primary);
            padding: 8px 10px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        .date-point strong {
            display: block;
            color: var(--text-primary);
            font-size: 14px;
            margin-top: 2px;
        }

        .calendar-picker-wrap {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 10px;
        }

        .calendar-month {
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--bg-primary);
            overflow: hidden;
        }

        .calendar-month-head {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-weight: 600;
            font-size: 13px;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 4px;
            padding: 8px;
        }

        .calendar-cell {
            min-height: 30px;
            border-radius: 8px;
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .calendar-head {
            color: var(--text-secondary);
            min-height: 20px;
            font-size: 11px;
            text-transform: uppercase;
        }

        .calendar-day {
            cursor: pointer;
            color: #dcfce7;
            background: rgba(34, 197, 94, 0.14);
            border-color: rgba(34, 197, 94, 0.3);
        }

        .calendar-day:hover {
            filter: brightness(1.08);
        }

        .calendar-day-other {
            opacity: 0.25;
            cursor: default;
        }

        .calendar-day-selected {
            background: rgba(239, 68, 68, 0.22);
            border-color: rgba(239, 68, 68, 0.48);
            color: #fee2e2;
            font-weight: 700;
        }

        .calendar-day-between {
            background: rgba(234, 179, 8, 0.2);
            border-color: rgba(234, 179, 8, 0.42);
            color: #fef3c7;
        }

        .calendar-day-today {
            outline: 2px solid var(--accent);
            outline-offset: -2px;
        }

        .date-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .date-field label {
            font-size: 12px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.35px;
            font-weight: 600;
        }

        .date-field input[type="date"] {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px 10px;
            background: var(--bg-primary);
            color: var(--text-primary);
            width: 100%;
        }

        .search-hint {
            margin-top: 10px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 12px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 600;
        }

        .filter-note {
            margin-top: 12px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        .category-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 12px 0 4px;
        }

        .category-chip {
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: var(--bg-primary);
            color: var(--text-secondary);
            font-size: 12px;
        }

    .empty-state {
        text-align: center;
        padding: 60px 40px;
        color: var(--text-secondary);
    }

    .empty-state-icon {
        font-size: 64px;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .vehicle-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }

    .vehicle-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
    }

    .vehicle-card:hover {
        border-color: var(--accent);
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(59, 130, 246, 0.15);
    }

    .vehicle-image {
        width: 100%;
        height: 160px;
        background: linear-gradient(135deg, var(--accent), #0ea5e9);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 56px;
        color: rgba(255, 255, 255, 0.3);
    }

    .vehicle-info {
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .vehicle-name {
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 6px;
        font-size: 15px;
    }

    .vehicle-brand {
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 8px;
    }

    .vehicle-price {
        font-size: 18px;
        font-weight: 700;
        color: var(--accent);
        margin-top: auto;
        padding-top: 12px;
        border-top: 1px solid var(--border);
    }

    .vehicle-estimate {
        margin-top: 8px;
        padding: 8px 10px;
        border: 1px dashed rgba(59, 130, 246, 0.4);
        border-radius: 8px;
        background: rgba(59, 130, 246, 0.1);
        color: #bfdbfe;
        font-size: 12px;
        line-height: 1.45;
    }

    .vehicle-availability {
        margin-top: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 12px;
        line-height: 1.45;
    }

    .vehicle-availability.available {
        border: 1px solid rgba(34, 197, 94, 0.4);
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
    }

    .vehicle-availability.busy {
        border: 1px solid rgba(239, 68, 68, 0.45);
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
    }

    @@media (max-width: 768px) {
        .search-strip {
            grid-template-columns: 1fr;
        }

        .search-submit {
            min-height: 48px;
        }

        .vehicle-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .card {
            padding: 16px;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }
</style>

<div class="container mt-5">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">✓ @success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-error">✕ @error</div>
    }
    @if (TempData["Info"] is string info)
    {
        <div class="alert alert-info">ℹ @info</div>
    }

    <div class="card" style="margin-bottom: 24px;">
        <div class="card-header">
            <h2>🔎 Tìm xe nhanh</h2>
        </div>
        <form asp-action="Index" method="get" style="display:grid; gap:16px;">
            <div class="search-strip">
                <div class="search-cell">
                    <label class="search-cell-label" for="q">Tên liên quan</label>
                    <input id="q" name="q" type="text" value="@Model.SearchKeyword" placeholder="Nhập tên xe, hãng xe, loại xe..." />
                </div>

                <div class="search-cell">
                    <label class="search-cell-label" for="dateRangeDisplay">Khoảng ngày thuê</label>
                    <button type="button" id="openDateRangeModal" class="date-range-btn">
                        <span id="dateRangeDisplay">@(Model.CheckInDate.HasValue && Model.CheckOutDate.HasValue ? $"{Model.CheckInDate.Value:dd/MM/yyyy} - {Model.CheckOutDate.Value:dd/MM/yyyy}" : "Chọn từ ngày đến ngày")</span>
                    </button>
                    <input id="checkIn" name="checkIn" type="hidden" value="@(Model.CheckInDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                    <input id="checkOut" name="checkOut" type="hidden" value="@(Model.CheckOutDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                </div>

                <div class="search-cell">
                    <label class="search-cell-label" for="amenityHint">Tiện nghi</label>
                    <button type="button" id="openAmenityModal" class="amenity-open-btn">
                        <span id="amenityHint">@selectedAmenitiesText</span>
                        <span id="amenityCountBadge" class="amenity-count-badge"></span>
                    </button>
                </div>

                <button type="submit" class="search-submit">Tìm</button>
            </div>

            @if (Model.AmenityOptions.Any())
            {
                <div id="dateRangeModal" class="amenity-modal" aria-hidden="true">
                    <div class="amenity-modal-card" role="dialog" aria-modal="true" aria-labelledby="dateRangeModalTitle">
                        <div class="amenity-modal-head">
                            <h3 id="dateRangeModalTitle" style="font-size:16px; margin:0;">Chọn khoảng ngày thuê</h3>
                            <button type="button" class="btn btn-secondary" id="closeDateRangeModal">Đóng</button>
                        </div>
                        <div class="amenity-modal-body">
                            <div class="date-range-summary">
                                <div class="date-point">Từ ngày<strong id="selectedStartText">Chưa chọn</strong></div>
                                <div class="date-point">Đến ngày<strong id="selectedEndText">Chưa chọn</strong></div>
                            </div>
                            <div class="search-hint" style="margin-top:0;">Click lần 1 chọn ngày nhận, lần 2 chọn ngày trả, click tiếp sẽ chọn lại từ ngày mới.</div>
                            <div id="dateRangeCalendar" class="calendar-picker-wrap"></div>
                        </div>
                        <div class="amenity-modal-actions">
                            <button type="button" class="btn btn-secondary" id="clearDateRange">Bỏ chọn ngày</button>
                            <button type="button" class="btn btn-primary" id="applyDateRange">Xong</button>
                        </div>
                    </div>
                </div>

                <div id="amenityModal" class="amenity-modal" aria-hidden="true">
                    <div class="amenity-modal-card" role="dialog" aria-modal="true" aria-labelledby="amenityModalTitle">
                        <div class="amenity-modal-head">
                            <h3 id="amenityModalTitle" style="font-size:16px; margin:0;">Chọn tiện nghi</h3>
                            <button type="button" class="btn btn-secondary" id="closeAmenityModal">Đóng</button>
                        </div>
                        <div class="amenity-modal-body">
                            <div class="amenity-checkbox-grid">
                                @foreach (var amenity in Model.AmenityOptions)
                                {
                                    var isChecked = Model.SelectedAmenityCodes.Any(code => string.Equals(code, amenity.Code, StringComparison.OrdinalIgnoreCase));
                                    <label class="amenity-chip">
                                        <input type="checkbox" name="amenities" value="@amenity.Code" data-amenity-name="@amenity.Name" @(isChecked ? "checked" : null) />
                                        <span>@amenity.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="amenity-modal-actions">
                            <button type="button" class="btn btn-secondary" id="clearAmenities">Bỏ chọn tất cả</button>
                            <button type="button" class="btn btn-primary" id="applyAmenities">Xong</button>
                        </div>
                    </div>
                </div>
            }

            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <a href="/Customer/Index" class="btn btn-secondary">Xóa lọc</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword)
                || Model.CheckInDate.HasValue
                || Model.CheckOutDate.HasValue
                || Model.SelectedAmenityCodes.Any())
            {
                <div class="search-hint">
                    Đang lọc theo: từ khóa = @(string.IsNullOrWhiteSpace(Model.SearchKeyword) ? "(trống)" : Model.SearchKeyword),
                    từ ngày = @(Model.CheckInDate.HasValue ? Model.CheckInDate.Value.ToString("dd/MM/yyyy") : "chưa chọn"),
                    đến ngày = @(Model.CheckOutDate.HasValue ? Model.CheckOutDate.Value.ToString("dd/MM/yyyy") : "chưa chọn"),
                    tiện nghi = @(Model.SelectedAmenityCodes.Any() ? selectedAmenitiesText : "Tất cả").
                </div>
            }
        </form>
    </div>

    <!-- Available Vehicles -->
    <div class="card">
        <div class="card-header">
            <h2>🚗 Xe sẵn sàng thuê</h2>
            <span class="badge badge-approved">@Model.Vehicles.Count xe phù hợp</span>
        </div>
        <p style="margin-bottom: 16px; color: var(--text-secondary); font-size: 13px;">
            Đây là danh sách xe hệ thống đang mở cho khách đặt thuê.
        </p>

        @if (Model.Vehicles.Any())
        {
            var categories = Model.Vehicles
                .GroupBy(v => string.IsNullOrWhiteSpace(v.TypeName) ? "Khác" : v.TypeName)
                .OrderByDescending(group => group.Count())
                .Take(8)
                .ToList();

            <div class="category-chips">
                @foreach (var category in categories)
                {
                    <span class="category-chip">@category.Key (@category.Count())</span>
                }
            </div>
        }

        @if (Model.Vehicles.Any())
        {
            <div class="vehicle-grid">
                @foreach (var vehicle in Model.Vehicles.Take(12))
                {
                    var detailsUrl = Url.Action(
                        "VehicleDetails",
                        "Customer",
                        new
                        {
                            id = vehicle.VehicleId,
                            checkIn = Model.CheckInDate?.ToString("yyyy-MM-dd"),
                            checkOut = Model.CheckOutDate?.ToString("yyyy-MM-dd")
                        }) ?? $"/Customer/VehicleDetails?id={vehicle.VehicleId}";

                    <a class="vehicle-card" href="@detailsUrl">
                        <div class="vehicle-image">🚗</div>
                        <div class="vehicle-info">
                            <div class="vehicle-name">@vehicle.VehicleName</div>
                            <div class="vehicle-brand">@vehicle.BrandName • @vehicle.TypeName</div>
                            <div class="vehicle-price">@vehicle.PricePerDay.ToString("C0")/ngày</div>
                            @if (Model.CheckInDate.HasValue && Model.CheckOutDate.HasValue)
                            {
                                <div class="vehicle-availability @(vehicle.IsAvailableForSelectedDates ? "available" : "busy")">
                                    @vehicle.AvailabilityNote
                                </div>
                            }
                            @if (vehicle.EstimatedRentalCost.HasValue && Model.CheckInDate.HasValue && Model.CheckOutDate.HasValue)
                            {
                                <div class="vehicle-estimate">
                                    Tạm tính: <strong>@vehicle.EstimatedRentalCost.Value.ToString("N0") VND</strong>
                                    cho @(vehicle.EstimatedRentalDays ?? Math.Max(1, (Model.CheckOutDate.Value.Date - Model.CheckInDate.Value.Date).Days)) ngày.
                                </div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">🚗</div>
                <p>Không có xe phù hợp với bộ lọc hiện tại.</p>
                <p style="margin-top: 8px; font-size: 13px;">Hãy thử bỏ bớt tiện nghi hoặc chọn lại danh mục hãng/loại xe.</p>
            </div>
        }
    </div>

    <!-- Favorite Vehicles -->
    @if (Model.FavoriteVehicles.Any())
    {
        <div class="card">
            <div class="card-header">
                <h2>❤️ Xe yêu thích</h2>
            </div>
            <div class="vehicle-grid">
                @foreach (var vehicle in Model.FavoriteVehicles)
                {
                    var favoriteDetailsUrl = Url.Action(
                        "VehicleDetails",
                        "Customer",
                        new
                        {
                            id = vehicle.VehicleId,
                            checkIn = Model.CheckInDate?.ToString("yyyy-MM-dd"),
                            checkOut = Model.CheckOutDate?.ToString("yyyy-MM-dd")
                        }) ?? $"/Customer/VehicleDetails?id={vehicle.VehicleId}";

                    <a class="vehicle-card" href="@favoriteDetailsUrl">
                        <div class="vehicle-image">❤️</div>
                        <div class="vehicle-info">
                            <div class="vehicle-name">@vehicle.VehicleName</div>
                            <div class="vehicle-brand">@vehicle.BrandName • @vehicle.TypeName</div>
                            <div class="vehicle-price">@vehicle.PricePerDay.ToString("C0")/ngày</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>

<script>
    (function () {
        const dateRangeModal = document.getElementById('dateRangeModal');
        const openDateRangeButton = document.getElementById('openDateRangeModal');
        const closeDateRangeButton = document.getElementById('closeDateRangeModal');
        const applyDateRangeButton = document.getElementById('applyDateRange');
        const clearDateRangeButton = document.getElementById('clearDateRange');
        const dateRangeCalendar = document.getElementById('dateRangeCalendar');
        const selectedStartText = document.getElementById('selectedStartText');
        const selectedEndText = document.getElementById('selectedEndText');
        const hiddenCheckIn = document.getElementById('checkIn');
        const hiddenCheckOut = document.getElementById('checkOut');
        const dateRangeDisplay = document.getElementById('dateRangeDisplay');

        const modal = document.getElementById('amenityModal');
        const openButton = document.getElementById('openAmenityModal');
        const closeButton = document.getElementById('closeAmenityModal');
        const applyButton = document.getElementById('applyAmenities');
        const clearButton = document.getElementById('clearAmenities');
        const amenityHint = document.getElementById('amenityHint');
        const amenityCountBadge = document.getElementById('amenityCountBadge');
        const amenityInputs = Array.from(document.querySelectorAll('input[name="amenities"]'));

        if (!modal || !openButton || !amenityHint) {
            return;
        }

        const rangeState = {
            start: '',
            end: ''
        };

        function formatDisplayDate(value) {
            if (!value) {
                return 'Chưa chọn';
            }

            const [y, m, d] = value.split('-');
            return `${d}/${m}/${y}`;
        }

        function toDate(value) {
            const [year, month, day] = (value || '').split('-').map(Number);
            if (!year || !month || !day) {
                return null;
            }

            const dt = new Date(year, month - 1, day);
            dt.setHours(0, 0, 0, 0);
            return dt;
        }

        function toKey(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function refreshDatePointLabels() {
            if (selectedStartText) {
                selectedStartText.textContent = formatDisplayDate(rangeState.start);
            }

            if (selectedEndText) {
                selectedEndText.textContent = formatDisplayDate(rangeState.end);
            }
        }

        function refreshDateRangeDisplay() {
            if (!hiddenCheckIn || !hiddenCheckOut || !dateRangeDisplay) {
                return;
            }

            const start = hiddenCheckIn.value;
            const end = hiddenCheckOut.value;
            if (start && end) {
                const [startY, startM, startD] = start.split('-');
                const [endY, endM, endD] = end.split('-');
                dateRangeDisplay.textContent = `${startD}/${startM}/${startY} - ${endD}/${endM}/${endY}`;
            } else {
                dateRangeDisplay.textContent = 'Chọn từ ngày đến ngày';
            }
        }

        function buildDateMonth(year, month) {
            const monthElement = document.createElement('div');
            monthElement.className = 'calendar-month';

            const monthHeader = document.createElement('div');
            monthHeader.className = 'calendar-month-head';
            monthHeader.textContent = new Date(year, month, 1).toLocaleDateString('vi-VN', { month: 'long', year: 'numeric' });
            monthElement.appendChild(monthHeader);

            const grid = document.createElement('div');
            grid.className = 'calendar-grid';
            ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'].forEach(dayName => {
                const head = document.createElement('div');
                head.className = 'calendar-cell calendar-head';
                head.textContent = dayName;
                grid.appendChild(head);
            });

            const firstDay = new Date(year, month, 1);
            const gridStart = new Date(firstDay);
            gridStart.setDate(gridStart.getDate() - firstDay.getDay());

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const startDate = toDate(rangeState.start);
            const endDate = toDate(rangeState.end);

            for (let i = 0; i < 42; i++) {
                const current = new Date(gridStart);
                current.setDate(gridStart.getDate() + i);

                const cell = document.createElement('button');
                cell.type = 'button';
                cell.className = 'calendar-cell calendar-day';
                cell.textContent = String(current.getDate());

                const key = toKey(current);
                if (current.getMonth() !== month) {
                    cell.classList.add('calendar-day-other');
                }

                if (startDate && key === toKey(startDate)) {
                    cell.classList.add('calendar-day-selected');
                }

                if (endDate && key === toKey(endDate)) {
                    cell.classList.add('calendar-day-selected');
                }

                if (startDate && endDate && current > startDate && current < endDate) {
                    cell.classList.add('calendar-day-between');
                }

                if (key === toKey(today)) {
                    cell.classList.add('calendar-day-today');
                }

                cell.addEventListener('click', () => {
                    const clicked = key;
                    const hasStart = Boolean(rangeState.start);
                    const hasEnd = Boolean(rangeState.end);

                    if (!hasStart || (hasStart && hasEnd)) {
                        rangeState.start = clicked;
                        rangeState.end = '';
                    } else {
                        if (clicked >= rangeState.start) {
                            rangeState.end = clicked;
                        } else {
                            rangeState.end = rangeState.start;
                            rangeState.start = clicked;
                        }
                    }

                    refreshDatePointLabels();
                    renderDateRangeCalendar();
                });

                grid.appendChild(cell);
            }

            monthElement.appendChild(grid);
            return monthElement;
        }

        function renderDateRangeCalendar() {
            if (!dateRangeCalendar) {
                return;
            }

            dateRangeCalendar.innerHTML = '';
            const base = new Date();
            base.setDate(1);

            for (let offset = 0; offset < 6; offset++) {
                const target = new Date(base.getFullYear(), base.getMonth() + offset, 1);
                dateRangeCalendar.appendChild(buildDateMonth(target.getFullYear(), target.getMonth()));
            }
        }

        function openDateRangeModal() {
            if (!dateRangeModal || !hiddenCheckIn || !hiddenCheckOut) {
                return;
            }

            rangeState.start = hiddenCheckIn.value || '';
            rangeState.end = hiddenCheckOut.value || '';
            refreshDatePointLabels();
            renderDateRangeCalendar();
            dateRangeModal.classList.add('show');
            dateRangeModal.setAttribute('aria-hidden', 'false');
        }

        function closeDateRangeModal() {
            if (!dateRangeModal) {
                return;
            }

            dateRangeModal.classList.remove('show');
            dateRangeModal.setAttribute('aria-hidden', 'true');
        }

        openDateRangeButton?.addEventListener('click', openDateRangeModal);
        closeDateRangeButton?.addEventListener('click', closeDateRangeModal);
        applyDateRangeButton?.addEventListener('click', () => {
            if (!hiddenCheckIn || !hiddenCheckOut) {
                return;
            }

            if (rangeState.start && !rangeState.end) {
                rangeState.end = rangeState.start;
            }

            hiddenCheckIn.value = rangeState.start || '';
            hiddenCheckOut.value = rangeState.end || '';
            refreshDateRangeDisplay();
            closeDateRangeModal();
        });

        clearDateRangeButton?.addEventListener('click', () => {
            if (!hiddenCheckIn || !hiddenCheckOut) {
                return;
            }

            hiddenCheckIn.value = '';
            hiddenCheckOut.value = '';
            rangeState.start = '';
            rangeState.end = '';
            refreshDatePointLabels();
            renderDateRangeCalendar();
            refreshDateRangeDisplay();
        });

        dateRangeModal?.addEventListener('click', (event) => {
            if (event.target === dateRangeModal) {
                closeDateRangeModal();
            }
        });

        function getSelectedAmenityNames() {
            return amenityInputs
                .filter(input => input.checked)
                .map(input => input.getAttribute('data-amenity-name') || '')
                .filter(Boolean);
        }

        function refreshAmenityHint() {
            const selected = getSelectedAmenityNames();
            amenityHint.textContent = selected.length > 0 ? selected.join(', ') : 'Tất cả tiện nghi';

            if (!amenityCountBadge) {
                return;
            }

            if (selected.length > 0) {
                amenityCountBadge.style.display = 'inline-flex';
                amenityCountBadge.textContent = `${selected.length} tiện nghi`;
            } else {
                amenityCountBadge.style.display = 'none';
                amenityCountBadge.textContent = '';
            }
        }

        function openModal() {
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
        }

        function closeModal() {
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
        }

        openButton.addEventListener('click', openModal);
        closeButton?.addEventListener('click', closeModal);
        applyButton?.addEventListener('click', () => {
            refreshAmenityHint();
            closeModal();
        });
        clearButton?.addEventListener('click', () => {
            amenityInputs.forEach(input => {
                input.checked = false;
            });
            refreshAmenityHint();
        });

        amenityInputs.forEach(input => {
            input.addEventListener('change', refreshAmenityHint);
        });

        modal.addEventListener('click', (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeDateRangeModal();
                closeModal();
            }
        });

        refreshDateRangeDisplay();
        refreshAmenityHint();
    })();
</script>
