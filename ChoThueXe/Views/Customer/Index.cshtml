@model ChoThueXe.Models.Portal.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Khach hang - Thue xe";
}

<h2 class="mb-3">Khach hang: Xem xe, cap nhat thong tin, dat thue</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Thong bao tu he thong va Admin</div>
    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0">
            <thead>
            <tr>
                <th>Thoi gian</th>
                <th>Tieu de</th>
                <th>Noi dung</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Notifications.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-muted">Chua co thong bao nao.</td>
                </tr>
            }
            else
            {
                @foreach (var n in Model.Notifications)
                {
                    <tr>
                        <td>@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@n.Title</td>
                        <td>@n.Message</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Tim kiem xe theo tu khoa va tien nghi</div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-lg-4">
                <label class="form-label">Tu khoa</label>
                <input class="form-control" type="text" name="q" value="@Model.SearchKeyword" placeholder="VD: toyota, sedan, 7 cho" />
            </div>
            <div class="col-lg-8">
                <label class="form-label d-block">Loc theo tien nghi</label>
                <div class="row g-2">
                    @foreach (var am in Model.AmenityOptions)
                    {
                        var isChecked = Model.SelectedAmenityCodes.Contains(am.Code);
                        <div class="col-md-4 col-6">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="amenities" value="@am.Code" checked="@isChecked" />
                                <span class="form-check-label">@am.Name</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tim va loc</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xoa loc</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">Cap nhat thong tin ca nhan</div>
            <div class="card-body">
                <p class="small text-muted mb-3">Thay doi ho ten/so dien thoai se tao yeu cau cho Admin duyet truoc khi cap nhat.</p>
                <form asp-action="UpdateProfile" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Ho ten</label>
                        <input class="form-control" name="FullName" value="@Model.FullName" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="col-12">
                        <label class="form-label">So dien thoai</label>
                        <input class="form-control" name="Phone" value="@Model.Phone" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Luu thong tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">Upload giay to (CCCD/Bang lai)</div>
            <div class="card-body">
                <form asp-action="SubmitDocument" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Loai giay to</label>
                        <select name="DocType" class="form-select">
                            <option value="CCCD">CCCD</option>
                            <option value="DRIVER_LICENSES">DRIVER_LICENSES</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Link tep (neu co)</label>
                        <input class="form-control" name="FileUrl" placeholder="https://..." />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-secondary">Gui duyet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Review xe sau khi hoan tat hop dong</div>
    <div class="card-body">
        <form asp-action="SubmitReview" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-lg-4">
                <label class="form-label">Hop dong co the review</label>
                <select name="ContractId" class="form-select" required>
                    <option value="">-- Chon hop dong --</option>
                    @foreach (var rc in Model.ReviewableContracts)
                    {
                        <option value="@rc.ContractId">#@rc.ContractId - @rc.VehicleName - @rc.EndDate:yyyy-MM-dd</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Danh gia</label>
                <select name="Rating" class="form-select" required>
                    <option value="5">5 sao</option>
                    <option value="4">4 sao</option>
                    <option value="3">3 sao</option>
                    <option value="2">2 sao</option>
                    <option value="1">1 sao</option>
                </select>
            </div>
            <div class="col-lg-4">
                <label class="form-label">Nhan xet</label>
                <input class="form-control" name="Comment" maxlength="1000" placeholder="Trai nghiem cua ban ve xe..." />
            </div>
            <div class="col-lg-2">
                <button type="submit" class="btn btn-success w-100">Gui review</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Preview chi phi</div>
            <div class="card-body">
                <form asp-action="Preview" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CustomerId" value="0" />
                    <input type="hidden" name="EmployeeId" value="0" />
                    <div class="col-12">
                        <label class="form-label">Chon xe</label>
                        <select name="VehicleId" class="form-select" required>
                            <option value="">-- Chon xe --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleName - @v.BrandName - @v.PricePerDay.ToString("N0") VND/ngay</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay bat dau</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay ket thuc</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-dark">Tinh truoc chi phi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Dat thue xe</div>
            <div class="card-body">
                <form asp-action="Rent" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CustomerId" value="0" />
                    <input type="hidden" name="EmployeeId" value="0" />
                    <div class="col-12">
                        <label class="form-label">Chon xe</label>
                        <select name="VehicleId" class="form-select" required>
                            <option value="">-- Chon xe --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleName - @v.BrandName - @v.PricePerDay.ToString("N0") VND/ngay</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay bat dau</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay ket thuc</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Dat thue</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Nhan tin voi Admin</div>
    <div class="card-body">
        <form asp-action="SendMessage" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-lg-10">
                <input class="form-control" name="Content" maxlength="1000" placeholder="Can ho tro gi ve xe, hop dong, thanh toan..." required />
            </div>
            <div class="col-lg-2">
                <button type="submit" class="btn btn-outline-primary w-100">Gui</button>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0">
            <thead>
            <tr>
                <th>Thoi gian</th>
                <th>Tin nhan</th>
                <th>Phan hoi Admin</th>
                <th>Trang thai</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Messages.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">Ban chua gui tin nhan nao.</td>
                </tr>
            }
            else
            {
                @foreach (var m in Model.Messages)
                {
                    <tr>
                        <td>@m.SentAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@m.Content</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(m.ReplyContent))
                            {
                                <span class="text-muted">Dang cho tra loi</span>
                            }
                            else
                            {
                                @m.ReplyContent
                            }
                        </td>
                        <td>@m.Status</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Danh sach xe yeu thich</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Xe</th>
                <th>Hang</th>
                <th>Loai</th>
                <th>Tien nghi</th>
                <th>Gia/ngay</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.FavoriteVehicles.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted">Ban chua co xe nao trong danh sach yeu thich.</td>
                </tr>
            }
            else
            {
                @foreach (var f in Model.FavoriteVehicles)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(f.PrimaryImageUrl))
                            {
                                <img src="@f.PrimaryImageUrl" alt="@f.VehicleName" style="width:64px;height:44px;object-fit:cover;border-radius:6px;margin-right:8px;" />
                            }
                            @f.VehicleName
                        </td>
                        <td>@f.BrandName</td>
                        <td>@f.TypeName</td>
                        <td>@(string.IsNullOrWhiteSpace(f.AmenitiesText) ? "-" : f.AmenitiesText)</td>
                        <td>@f.PricePerDay.ToString("N0")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Thanh toan hop dong cua toi</div>
    <div class="card-body">
        <form asp-action="Pay" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label">Hop dong PENDING</label>
                <select name="ContractId" class="form-select" required>
                    <option value="">-- Chon hop dong --</option>
                    @foreach (var p in Model.PendingContracts)
                    {
                        <option value="@p.ContractId">#@p.ContractId - Tong: @p.TotalAmount.ToString("N0") - Da tra: @p.PaidAmount.ToString("N0") - Con: @p.DueAmount.ToString("N0")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">So tien tra</label>
                <input type="number" step="1000" min="1" name="Amount" class="form-control" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">Thanh toan</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Xe dang co (vw_vehicle_detail)</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Anh</th>
                <th>ID</th>
                <th>Ten xe</th>
                <th>Hang</th>
                <th>Loai</th>
                <th>Tien nghi</th>
                <th>Gia/ngay</th>
                <th>Yeu thich</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var v in Model.Vehicles)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(v.PrimaryImageUrl))
                        {
                            <img src="@v.PrimaryImageUrl" alt="@v.VehicleName" style="width:72px;height:48px;object-fit:cover;border-radius:6px;" />
                        }
                        else
                        {
                            <span class="text-muted">Khong co</span>
                        }
                    </td>
                    <td>@v.VehicleId</td>
                    <td>@v.VehicleName</td>
                    <td>@v.BrandName</td>
                    <td>@v.TypeName</td>
                    <td>@(string.IsNullOrWhiteSpace(v.AmenitiesText) ? "-" : v.AmenitiesText)</td>
                    <td>@v.PricePerDay.ToString("N0")</td>
                    <td>
                        <form asp-action="ToggleFavorite" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="vehicleId" value="@v.VehicleId" />
                            <button type="submit" class="btn btn-sm @(v.IsFavorite ? "btn-danger" : "btn-outline-secondary")" title="Yeu thich">
                                @(v.IsFavorite ? "Tim" : "Them")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Hop dong cua toi</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Xe</th>
                <th>Tu ngay</th>
                <th>Den ngay</th>
                <th>Tong tien</th>
                <th>Trang thai</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Contracts)
            {
                <tr>
                    <td>@c.ContractId</td>
                    <td>@c.VehicleName</td>
                    <td>@c.StartDate:yyyy-MM-dd</td>
                    <td>@c.EndDate:yyyy-MM-dd</td>
                    <td>@c.TotalAmount.ToString("N0")</td>
                    <td>@c.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
