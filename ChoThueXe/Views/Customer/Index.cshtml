@model ChoThueXe.Models.Portal.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Khách hàng - Thuê xe";
}

<h2 class="mb-3">Khách hàng: Xem xe, cập nhật thông tin, đặt thuê</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Thông báo từ hệ thống và Admin</div>
    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0">
            <thead>
            <tr>
                <th>Thời gian</th>
                <th>Tiêu đề</th>
                <th>Nội dung</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Notifications.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-muted">Chưa có thông báo nào.</td>
                </tr>
            }
            else
            {
                @foreach (var n in Model.Notifications)
                {
                    <tr>
                        <td>@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@n.Title</td>
                        <td>@n.Message</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Tìm kiếm xe theo từ khóa và tiện nghi</div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-lg-4">
                <label class="form-label">Từ khóa</label>
                <input class="form-control" type="text" name="q" value="@Model.SearchKeyword" placeholder="VD: toyota, sedan, 7 chỗ" />
            </div>
            <div class="col-lg-8">
                <label class="form-label d-block">Lọc theo tiện nghi</label>
                <div class="row g-2">
                    @foreach (var am in Model.AmenityOptions)
                    {
                        var isChecked = Model.SelectedAmenityCodes.Contains(am.Code);
                        <div class="col-md-4 col-6">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="amenities" value="@am.Code" checked="@isChecked" />
                                <span class="form-check-label">@am.Name</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tìm và lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">Cập nhật thông tin cá nhân</div>
            <div class="card-body">
                <p class="small text-muted mb-3">Thay đổi họ tên/số điện thoại sẽ tạo yêu cầu cho Admin duyệt trước khi cập nhật.</p>
                <form asp-action="UpdateProfile" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Họ tên</label>
                        <input class="form-control" name="FullName" value="@Model.FullName" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Số điện thoại</label>
                        <input class="form-control" name="Phone" value="@Model.Phone" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">Upload giấy tở (CCCD/Bằng lái)</div>
            <div class="card-body">
                <form asp-action="SubmitDocument" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Loại giấy tở</label>
                        <select name="DocType" class="form-select">
                            <option value="CCCD">CCCD</option>
                            <option value="DRIVER_LICENSES">DRIVER_LICENSES</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Link tệp (nếu có)</label>
                        <input class="form-control" name="FileUrl" placeholder="https://..." />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-secondary">Gửi duyệt</button>
                    </div>
                </form>

                <hr />

                <h6>Gửi thông tin bằng lái (lưu trong drive_licenses)</h6>
                <form asp-action="SubmitDriveLicense" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Số bằng lái</label>
                        <input class="form-control" name="LicenseNumber" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Cơ quan cấp</label>
                        <input class="form-control" name="IssuedBy" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày cấp</label>
                        <input type="date" class="form-control" name="IssuedAt" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày hết hạn</label>
                        <input type="date" class="form-control" name="ExpireAt" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Gửi bằng lái</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Review xe sau khi hoàn tất hợp đồng</div>
    <div class="card-body">
        <form asp-action="SubmitReview" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-lg-4">
                <label class="form-label">Hợp đồng có thể review</label>
                <select name="ContractId" class="form-select" required>
                    <option value="">-- Chọn hợp đồng --</option>
                    @foreach (var rc in Model.ReviewableContracts)
                    {
                        <option value="@rc.ContractId">#@rc.ContractId - @rc.VehicleName - @rc.EndDate:yyyy-MM-dd</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Danh giá</label>
                <select name="Rating" class="form-select" required>
                    <option value="5">5 sao</option>
                    <option value="4">4 sao</option>
                    <option value="3">3 sao</option>
                    <option value="2">2 sao</option>
                    <option value="1">1 sao</option>
                </select>
            </div>
            <div class="col-lg-4">
                <label class="form-label">Nhận xét</label>
                <input class="form-control" name="Comment" maxlength="1000" placeholder="Trải nghiệm của bạn về xe..." />
            </div>
            <div class="col-lg-2">
                <button type="submit" class="btn btn-success w-100">Gửi review</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Preview chi phí</div>
            <div class="card-body">
                <form asp-action="Preview" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CustomerId" value="0" />
                    <input type="hidden" name="EmployeeId" value="0" />
                    <div class="col-12">
                        <label class="form-label">Chọn xe</label>
                        <select name="VehicleId" class="form-select" required>
                            <option value="">-- Chọn xe --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleName - @v.BrandName - @v.PricePerDay.ToString("N0") VND/ngay</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày bắt đầu</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày kết thúc</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-dark">Tính trước chi phí</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Đặt thuê xe</div>
            <div class="card-body">
                <form asp-action="Rent" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CustomerId" value="0" />
                    <input type="hidden" name="EmployeeId" value="0" />
                    <div class="col-12">
                        <label class="form-label">Chọn xe</label>
                        <select name="VehicleId" class="form-select" required>
                            <option value="">-- Chọn xe --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleName - @v.BrandName - @v.PricePerDay.ToString("N0") VND/ngay</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày bắt đầu</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày kết thúc</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Đặt thuê</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Nhận tin với Admin</div>
    <div class="card-body">
        <form asp-action="SendMessage" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-lg-10">
                <input class="form-control" name="Content" maxlength="1000" placeholder="Cần hỗ trợ gì về xe, hợp đồng, thanh toán..." required />
            </div>
            <div class="col-lg-2">
                <button type="submit" class="btn btn-outline-primary w-100">Gửi</button>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0">
            <thead>
            <tr>
                <th>Thời gian</th>
                <th>Tin nhắn</th>
                <th>Phản hồi Admin</th>
                <th>Trạng thái</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Messages.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">Bạn chưa gửi tin nhắn nào.</td>
                </tr>
            }
            else
            {
                @foreach (var m in Model.Messages)
                {
                    <tr>
                        <td>@m.SentAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@m.Content</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(m.ReplyContent))
                            {
                                <span class="text-muted">Đang chờ trả lời</span>
                            }
                            else
                            {
                                @m.ReplyContent
                            }
                        </td>
                        <td>@m.Status</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Danh sách xe yêu thích</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Xe</th>
                <th>Hãng</th>
                <th>Loại</th>
                <th>Tiện nghi</th>
                <th>Giá/ngày</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.FavoriteVehicles.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted">Bạn chưa có xe nào trong danh sách yêu thích.</td>
                </tr>
            }
            else
            {
                @foreach (var f in Model.FavoriteVehicles)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(f.PrimaryImageUrl))
                            {
                                <img src="@f.PrimaryImageUrl" alt="@f.VehicleName" style="width:64px;height:44px;object-fit:cover;border-radius:6px;margin-right:8px;" />
                            }
                            <a href="@f.PrimaryImageUrl" target="_blank" rel="noopener">Xem CCCD</a>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Thanh toán hợp đồng của tôi</div>
    <div class="card-body">
        <form asp-action="Pay" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label">Hợp đồng PENDING</label>
                <select name="ContractId" class="form-select" required>
                    <option value="">-- Chọn hợp đồng --</option>
                    @foreach (var p in Model.PendingContracts)
                    {
                        <option value="@p.ContractId">#@p.ContractId - Tong: @p.TotalAmount.ToString("N0") - Da tra: @p.PaidAmount.ToString("N0") - Con: @p.DueAmount.ToString("N0")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Số tiền trả</label>
                <input type="number" step="1000" min="1" name="Amount" class="form-control" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">Thanh toán</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Xe đang có (vw_vehicle_detail)</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Ảnh</th>
                <th>ID</th>
                <th>Tên xe</th>
                <th>Hãng</th>
                <th>Loại</th>
                <th>Tiện nghi</th>
                <th>Giá/ngày</th>
                <th>Yêu thích</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var v in Model.Vehicles)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(v.PrimaryImageUrl))
                        {
                            <img src="@v.PrimaryImageUrl" alt="@v.VehicleName" style="width:72px;height:48px;object-fit:cover;border-radius:6px;" />
                        }
                        else
                        {
                            <span class="text-muted">Không có</span>
                        }
                    </td>
                    <td>@v.VehicleId</td>
                    <td>@v.VehicleName</td>
                    <td>@v.BrandName</td>
                    <td>@v.TypeName</td>
                    <td>@(string.IsNullOrWhiteSpace(v.AmenitiesText) ? "-" : v.AmenitiesText)</td>
                    <td>@v.PricePerDay.ToString("N0")</td>
                    <td>
                        <form asp-action="ToggleFavorite" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="vehicleId" value="@v.VehicleId" />
                            <button type="submit" class="btn btn-sm @(v.IsFavorite ? "btn-danger" : "btn-outline-secondary")" title="Yêu thích">
                                @(v.IsFavorite ? "Bỏ tím" : "Thêm")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Hợp đồng của tôi</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Xe</th>
                <th>Từ ngày</th>
                <th>Đến ngày</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Contracts)
            {
                <tr>
                    <td>@c.ContractId</td>
                    <td>@c.VehicleName</td>
                    <td>@c.StartDate:yyyy-MM-dd</td>
                    <td>@c.EndDate:yyyy-MM-dd</td>
                    <td>@c.TotalAmount.ToString("N0")</td>
                    <td>@c.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
