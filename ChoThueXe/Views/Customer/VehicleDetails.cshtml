@using ChoThueXe.Models.Portal
@model VehicleDetailsViewModel

@{
    ViewData["Title"] = $"Chi tiết xe - {Model.VehicleName} | ChoThueXe";
}

<style>
    :root {
        --bg-primary: #0f1117;
        --bg-secondary: #161b27;
        --bg-tertiary: #21262d;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --border: #30363d;
        --text-primary: #e2e8f0;
        --text-secondary: #8b949e;
        --success: #3fb950;
        --error: #f85149;
        --warning: #d29922;
        --info: #58a6ff;
        --radius: 8px;
        --radius-sm: 4px;
        --transition: all 0.2s ease;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: "Inter", sans-serif;
        line-height: 1.6;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }

    .vehicle-header {
        display: flex;
        gap: 24px;
        margin-bottom: 32px;
        align-items: flex-start;
    }

    .vehicle-image {
        width: 300px;
        height: 200px;
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        flex-shrink: 0;
    }

    .vehicle-info {
        flex: 1;
    }

    .vehicle-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .vehicle-meta {
        color: var(--text-secondary);
        margin-bottom: 16px;
        font-size: 16px;
    }

    .vehicle-price {
        font-size: 24px;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 16px;
    }

    .vehicle-amenities {
        color: var(--text-secondary);
        margin-bottom: 20px;
    }

    .availability-box {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 16px;
        font-size: 13px;
    }

    .availability-box.available {
        border-color: rgba(34, 197, 94, 0.45);
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
    }

    .availability-box.busy {
        border-color: rgba(239, 68, 68, 0.45);
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
    }

    .btn {
        padding: 10px 16px;
        border-radius: var(--radius-sm);
        border: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background-color: var(--accent);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
        transform: translateY(-2px);
    }

    .btn-secondary {
        background-color: var(--bg-secondary);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

    .btn-secondary:hover {
        background-color: var(--bg-tertiary);
        border-color: var(--accent);
    }

    .calendar-section {
        background: linear-gradient(180deg, rgba(59, 130, 246, 0.06), transparent 24%), var(--bg-secondary);
        border: 1px solid rgba(59, 130, 246, 0.18);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
    }

    .section-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .calendar-subtitle {
        color: var(--text-secondary);
        margin-top: -8px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .calendar-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 16px;
    }

    .calendar-month {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 18%), var(--bg-primary);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 16px;
        overflow: hidden;
    }

    .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .calendar-header .month-title {
        font-size: 15px;
        letter-spacing: 0.2px;
    }

    .calendar-header .month-stats {
        font-size: 12px;
        color: var(--text-secondary);
        padding: 6px 10px;
        border-radius: 999px;
        background-color: rgba(148, 163, 184, 0.08);
        border: 1px solid rgba(148, 163, 184, 0.15);
        white-space: nowrap;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .calendar-day {
        min-height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        border-radius: 10px;
        transition: var(--transition);
        border: 1px solid transparent;
        position: relative;
        user-select: none;
    }

    .calendar-day-header {
        font-weight: 600;
        color: var(--text-secondary);
        background-color: var(--bg-tertiary);
        min-height: 30px;
        border-radius: 8px;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.4px;
    }

    .calendar-day.rented {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.95), rgba(190, 18, 60, 0.92));
        color: white;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .calendar-day.available {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.92), rgba(21, 128, 61, 0.88));
        color: white;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .calendar-day.past {
        opacity: 0.45;
        filter: grayscale(0.2);
    }

    .calendar-day.today {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.28);
        transform: translateY(-1px);
    }

    .calendar-day:not(.calendar-day-header):hover {
        transform: translateY(-1px);
        border-color: rgba(59, 130, 246, 0.45);
    }

    .legend {
        display: flex;
        gap: 16px;
        justify-content: center;
        margin-top: 16px;
        font-size: 12px;
        color: var(--text-secondary);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .legend-color {
        width: 12px;
        height: 12px;
        border-radius: 2px;
    }

    .calendar-footer {
        margin-top: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        color: var(--text-secondary);
        font-size: 12px;
    }

    .calendar-footer strong {
        color: var(--text-primary);
    }

    @@media (max-width: 768px) {
        .vehicle-header {
            flex-direction: column;
        }

        .vehicle-image {
            width: 100%;
            height: 150px;
        }

        .calendar-container {
            grid-template-columns: 1fr;
        }

        .calendar-header {
            flex-direction: column;
            align-items: flex-start;
        }

    }
</style>

<div class="container">
    <div class="vehicle-header">
        <div class="vehicle-image">
            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl" alt="@Model.VehicleName" style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius);" />
            }
            else
            {
                <span>🚗</span>
            }
        </div>
        <div class="vehicle-info">
            <h1 class="vehicle-title">@Model.VehicleName</h1>
            <div class="vehicle-meta">@Model.BrandName • @Model.TypeName</div>
            <div class="vehicle-price">@Model.PricePerDay:N0 ₫/ngày</div>
            @if (!string.IsNullOrEmpty(Model.AmenitiesText))
            {
                <div class="vehicle-amenities">Tiện nghi: @Model.AmenitiesText</div>
            }
            @if (Model.SelectedCheckInDate.HasValue && Model.SelectedCheckOutDate.HasValue)
            {
                <div class="availability-box @(Model.IsAvailableForSelectedDates == false ? "busy" : "available")">
                    <div><strong>Khoảng ngày bạn chọn:</strong> @Model.SelectedCheckInDate.Value.ToString("dd/MM/yyyy") - @Model.SelectedCheckOutDate.Value.ToString("dd/MM/yyyy")</div>
                    <div>@Model.AvailabilityNote</div>
                    @if (Model.EstimatedRentalCost.HasValue)
                    {
                        <div style="margin-top:4px;">Tạm tính: <strong>@Model.EstimatedRentalCost.Value.ToString("N0") VND</strong> cho @(Model.EstimatedRentalDays ?? 1) ngày.</div>
                    }
                </div>
            }
            <div class="action-buttons">
                <a href="/Customer/Index" class="btn btn-secondary">← Quay lại</a>
                <form method="post" asp-action="ToggleFavorite" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" value="@Model.VehicleId" />
                    <button type="submit" class="btn @(Model.IsFavorite ? "btn-secondary" : "btn-primary")">
                        @(Model.IsFavorite ? "❤️ Đã yêu thích" : "🤍 Thêm yêu thích")
                    </button>
                </form>
                <a href="@Url.Action("Book", "Rental", new { vehicleId = Model.VehicleId, checkIn = Model.SelectedCheckInDate?.ToString("yyyy-MM-dd"), checkOut = Model.SelectedCheckOutDate?.ToString("yyyy-MM-dd") })" class="btn btn-primary">Đặt thuê ngay</a>
            </div>
        </div>
    </div>

    <div class="calendar-section">
        <h2 class="section-title">Lịch thuê xe (Heatmap)</h2>
        <div class="calendar-subtitle">Màu đỏ là ngày đã có khách thuê, màu xanh là ngày còn trống. Bạn có thể lướt nhanh để xem tình trạng từng tháng.</div>
        <div class="calendar-container" id="calendarContainer">
            <!-- Calendar sẽ được tạo bởi JavaScript -->
        </div>
        <div class="legend">
            <div class="legend-item">
                <div class="legend-color" style="background-color: var(--error);"></div>
                <span>Đã thuê</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background-color: var(--success);"></div>
                <span>Còn trống</span>
            </div>
        </div>
    </div>
</div>

@{
    var rentalDatesJson = Json.Serialize(Model.RentalDates.Select(d => new {
        startDate = d.StartDate.ToString("yyyy-MM-dd"),
        endDate = d.EndDate.ToString("yyyy-MM-dd")
    }));
}
<script>
    const rentalDates = @Html.Raw(rentalDatesJson);

    function isDateRented(date) {
        const dateStr = date.toISOString().split('T')[0];
        return rentalDates.some(range => {
            const start = new Date(range.startDate);
            const end = new Date(range.endDate);
            return date >= start && date <= end;
        });
    }

    function generateCalendar(year, month) {
        const firstDay = new Date(year, month, 1);
        const startDate = new Date(firstDay);
        startDate.setDate(startDate.getDate() - firstDay.getDay());

        const calendar = document.createElement('div');
        calendar.className = 'calendar-month';

        let rentedCount = 0;
        let availableCount = 0;

        const header = document.createElement('div');
        header.className = 'calendar-header';
        const monthTitle = document.createElement('span');
        monthTitle.className = 'month-title';
        monthTitle.textContent = new Date(year, month).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long' });

        const monthStats = document.createElement('span');
        monthStats.className = 'month-stats';
        monthStats.textContent = 'Đang tải...';

        header.appendChild(monthTitle);
        header.appendChild(monthStats);
        calendar.appendChild(header);

        const grid = document.createElement('div');
        grid.className = 'calendar-grid';

        // Header days
        const dayNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
        dayNames.forEach(day => {
            const dayHeader = document.createElement('div');
            dayHeader.className = 'calendar-day calendar-day-header';
            dayHeader.textContent = day;
            grid.appendChild(dayHeader);
        });

        // Calendar days
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let i = 0; i < 42; i++) {
            const currentDate = new Date(startDate);
            currentDate.setDate(startDate.getDate() + i);

            const dayElement = document.createElement('div');
            dayElement.className = 'calendar-day';
            dayElement.textContent = currentDate.getDate();

            const isCurrentMonth = currentDate.getMonth() === month;
            const isPastDate = currentDate < today;
            const rented = isDateRented(currentDate);

            if (!isCurrentMonth) {
                dayElement.style.opacity = '0.3';
                dayElement.title = 'Ngoài tháng';
            } else if (rented) {
                dayElement.classList.add('rented');
                dayElement.title = 'Đã thuê';
                rentedCount += 1;
            } else {
                dayElement.classList.add('available');
                dayElement.title = 'Còn trống';
                availableCount += 1;
            }

            if (isPastDate && isCurrentMonth) {
                dayElement.classList.add('past');
            }

            if (currentDate.getTime() === today.getTime()) {
                dayElement.classList.add('today');
                dayElement.title = rented ? 'Hôm nay - đã thuê' : 'Hôm nay - còn trống';
            }

            grid.appendChild(dayElement);
        }

        calendar.appendChild(grid);

        monthStats.textContent = `${rentedCount} đã thuê · ${availableCount} còn trống`;
        return calendar;
    }

    function initCalendar() {
        const container = document.getElementById('calendarContainer');
        const today = new Date();

        // Generate 6 months from current month
        for (let i = 0; i < 6; i++) {
            const targetDate = new Date(today.getFullYear(), today.getMonth() + i, 1);
            const calendar = generateCalendar(targetDate.getFullYear(), targetDate.getMonth());
            container.appendChild(calendar);
        }
    }

    // Initialize calendar when page loads
    document.addEventListener('DOMContentLoaded', initCalendar);
</script>