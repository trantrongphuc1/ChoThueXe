                        <span>20/03/2026 - 14:00</span>
                    </div>
                    <div class="detail-item">
                        <label>Ngày trả:</label>
                        <span>22/03/2026 - 14:00</span>
                    </div>
                    <div class="detail-item">
                        <label>Tổng tiền:</label>
                        <span style="color: var(--accent); font-weight: 700;">6.400.000đ</span>
                    </div>
