    <div class="filter-tabs">
        <button class="tab-btn active" onclick="filterOrders('all')">Tất cả (12)</button>
        <button class="tab-btn" onclick="filterOrders('upcoming')">Sắp tới (2)</button>
        <button class="tab-btn" onclick="filterOrders('completed')">Hoàn thành (9)</button>
