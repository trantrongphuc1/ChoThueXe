@model ChoThueXe.Models.Rental.RentalDashboardViewModel
@{
    ViewData["Title"] = "Quan ly thue xe";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">He thong Cho Thue Xe</h2>
    <span class="badge text-bg-primary">Oracle Procedure + Trigger + View</span>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">B1 - Tao hop dong nhap (sp_create_contract)</div>
            <div class="card-body">
                <form asp-action="CreateDraft" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Khach hang</label>
                        <select name="CustomerId" class="form-select" required>
                            <option value="">-- Chon khach hang --</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId">@user.UserId - @user.FullName (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nhan vien phu trach</label>
                        <select name="EmployeeId" class="form-select" required>
                            <option value="">-- Chon nhan vien --</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId">@user.UserId - @user.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Tao Draft Contract</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">B2-B4 - Thue xe (fn_is_user_verified + sp_rent_vehicle)</div>
            <div class="card-body">
                <form asp-action="Preview" method="post" class="row g-3 mb-2">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Xe</label>
                        <select name="VehicleId" class="form-select" required>
                            <option value="">-- Chon xe --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleId - @v.VehicleName (@v.PricePerDay.ToString("N0") VND/ngay)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay bat dau</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay ket thuc</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-secondary">Preview gia (fn_calculate_rental_cost)</button>
                    </div>
                </form>

                <hr />

                <form asp-action="Rent" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Khach hang</label>
                        <select name="CustomerId" class="form-select" required>
                            <option value="">-- Chon khach hang --</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId">@user.UserId - @user.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nhan vien phu trach</label>
                        <select name="EmployeeId" class="form-select" required>
                            <option value="">-- Chon nhan vien --</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId">@user.UserId - @user.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Xe</label>
                        <select name="VehicleId" class="form-select" required>
                            <option value="">-- Chon xe --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleId - @v.VehicleName (@v.PricePerDay.ToString("N0") VND/ngay)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay bat dau</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay ket thuc</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Thuc hien thue xe</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">B5 - Thanh toan (sp_make_payment + trg_payment_update_contract)</div>
            <div class="card-body">
                <form asp-action="Pay" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label">Hop dong dang PENDING</label>
                        <select name="ContractId" class="form-select" required>
                            <option value="">-- Chon hop dong --</option>
                            @foreach (var c in Model.PendingContracts)
                            {
                                <option value="@c.ContractId">#@c.ContractId - @c.CustomerName - Con lai: @c.DueAmount.ToString("N0")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">So tien thanh toan</label>
                        <input type="number" step="1000" min="1" name="Amount" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success">Thanh toan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Danh sach xe (vw_vehicle_detail)</div>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ten xe</th>
                        <th>Hang</th>
                        <th>Loai</th>
                        <th>Gia/ngay</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in Model.Vehicles)
                    {
                        <tr>
                            <td>@v.VehicleId</td>
                            <td>@v.VehicleName</td>
                            <td>@v.BrandName</td>
                            <td>@v.TypeName</td>
                            <td>@v.PricePerDay.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Hop dong tong hop (vw_contract_full)</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Khach hang</th>
                        <th>Xe</th>
                        <th>Tu ngay</th>
                        <th>Den ngay</th>
                        <th>Tong tien</th>
                        <th>Trang thai</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Contracts)
                    {
                        <tr>
                            <td>@c.ContractId</td>
                            <td>@c.FullName</td>
                            <td>@c.VehicleName</td>
                            <td>@c.StartDate:yyyy-MM-dd</td>
                            <td>@c.EndDate:yyyy-MM-dd</td>
                            <td>@c.TotalAmount.ToString("N0")</td>
                            <td><span class="badge text-bg-secondary">@c.Status</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Thong ke doanh thu (vw_revenue)</div>
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <thead>
                    <tr>
                        <th>Xe</th>
                        <th>Doanh thu</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Revenue)
                    {
                        <tr>
                            <td>@r.VehicleName</td>
                            <td>@r.TotalRevenue.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
