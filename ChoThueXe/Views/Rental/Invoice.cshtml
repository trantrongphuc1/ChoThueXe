            </div>
        </div>

        <!-- Summary -->
        <div class="summary-box">
            <div class="summary-row">
                <label>Giá cơ bản (3 ngày × 2.500.000đ):</label>
                <span>7.500.000đ</span>
            </div>

            <div class="summary-row">
                <label>Phí dịch vụ:</label>
                <span>150.000đ</span>
            </div>

            <div class="summary-row">
                <label>Bảo hiểm thêm:</label>
                <span>0đ</span>
            </div>

            <div class="summary-row">
                <label>Giảm giá (Mã: WELCOME20):</label>
                <span style="color: var(--success);">-250.000đ</span>
            </div>

            <div class="summary-total">
                <label>Tổng cộng:</label>
