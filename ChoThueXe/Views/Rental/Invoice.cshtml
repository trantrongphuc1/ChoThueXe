    </div>

    <div class="invoice-content">
        <!-- Company & Order Info -->
        <div class="invoice-grid">
            <div>
                <div class="invoice-section">
                    <h3>Công ty</h3>
                    <div class="invoice-info">
                        <strong>ChoThueXe</strong>
                        123 Nguyễn Huệ, Q1<br>
                        TP HCM, Việt Nam<br>
                        <br>
                        Email: info@chothueXe.com<br>
