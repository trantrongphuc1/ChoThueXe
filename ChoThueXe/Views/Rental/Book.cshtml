@using ChoThueXe.Models.Rental
@model RentVehicleInputModel

@{
    ViewData["Title"] = "Đặt xe";
    var vehicleName = ViewBag.VehicleName as string ?? "Xe đã chọn";
    var vehicleBrand = ViewBag.VehicleBrand as string ?? string.Empty;
    var vehicleType = ViewBag.VehicleType as string ?? string.Empty;
    var pricePerDay = ViewBag.PricePerDay is decimal price ? price : 0m;
}

<style>
    :root {
        --bg-primary: #0f1117;
        --bg-secondary: #161b27;
        --bg-tertiary: #21262d;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --border: #30363d;
        --text-primary: #e2e8f0;
        --text-secondary: #8b949e;
        --success: #3fb950;
        --danger: #f85149;
        --warning: #d29922;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
    }

    .booking-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .booking-header {
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border);
    }

    .booking-header h1 {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .booking-header p {
        color: var(--text-secondary);
        font-size: 16px;
    }

    .booking-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 30px;
        margin-bottom: 40px;
    }

    .booking-form {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 30px;
    }

    .form-section {
        margin-bottom: 30px;
    }

    .form-section:last-child {
        margin-bottom: 0;
    }

    .form-section-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .form-row.full {
        grid-template-columns: 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        padding: 12px 14px;
        background-color: var(--bg-tertiary);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 14px;
        font-family: inherit;
        transition: all 0.2s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--accent);
        background-color: rgba(59, 130, 246, 0.05);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 100px;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .checkbox-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .checkbox-group label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
    }

    /* Sidebar */
    .booking-summary {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        height: fit-content;
        position: sticky;
        top: 100px;
    }

    .summary-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }

    .vehicle-summary {
        background-color: var(--bg-tertiary);
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .vehicle-image {
        width: 100%;
        height: 120px;
        background: linear-gradient(135deg, var(--accent), #1e40af);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        margin-bottom: 12px;
    }

    .vehicle-name {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .vehicle-price {
        font-size: 16px;
        font-weight: 700;
        color: var(--accent);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        font-size: 14px;
        border-bottom: 1px solid var(--border);
    }

    .summary-row:last-child {
        border-bottom: none;
        padding-top: 12px;
        padding-bottom: 0;
    }

    .summary-row.total {
        font-size: 18px;
        font-weight: 700;
        color: var(--accent);
        padding-top: 16px;
        margin-top: 12px;
        border-top: 2px solid var(--border);
    }

    .summary-row label {
        color: var(--text-secondary);
    }

    .summary-row span {
        color: var(--text-primary);
    }

    .btn-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .btn {
        padding: 12px 16px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background-color: var(--accent);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
    }

    .btn-secondary {
        background-color: transparent;
        border: 1px solid var(--border);
        color: var(--text-primary);
    }

    .btn-secondary:hover {
        background-color: var(--bg-tertiary);
        border-color: var(--accent);
    }

    /* Validation */
    .error-message {
        color: var(--danger);
        font-size: 13px;
        margin-top: 6px;
    }

    .info-box {
        background-color: rgba(59, 130, 246, 0.1);
        border-left: 3px solid var(--accent);
        padding: 12px 14px;
        border-radius: 6px;
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 16px;
    }

    .info-box strong {
        color: var(--text-primary);
    }

    .date-picker-trigger {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-tertiary);
        color: var(--text-primary);
        padding: 12px 14px;
        font-size: 14px;
        text-align: left;
        cursor: pointer;
        width: 100%;
    }

    .booking-alert {
        border: 1px solid rgba(239, 68, 68, 0.45);
        background: rgba(239, 68, 68, 0.14);
        color: #fecaca;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
        margin-top: 10px;
        display: none;
    }

    .booking-alert.show {
        display: block;
    }

    .picker-modal {
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.72);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1200;
        padding: 16px;
    }

    .picker-modal.show {
        display: flex;
    }

    .picker-modal-card {
        width: min(900px, 100%);
        max-height: 92vh;
        overflow: auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-secondary);
    }

    .picker-head {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .picker-body {
        padding: 14px 16px;
        display: grid;
        gap: 10px;
    }

    .picker-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(140px, 1fr));
        gap: 10px;
    }

    .picker-point {
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--bg-primary);
        padding: 8px 10px;
        font-size: 12px;
        color: var(--text-secondary);
    }

    .picker-point strong {
        display: block;
        color: var(--text-primary);
        font-size: 14px;
        margin-top: 2px;
    }

    .picker-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .picker-nav-label {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .picker-calendars {
        display: grid;
        grid-template-columns: repeat(2, minmax(260px, 1fr));
        gap: 10px;
    }

    .picker-month {
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-primary);
        overflow: hidden;
    }

    .picker-month-head {
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        color: var(--text-primary);
        font-weight: 600;
        font-size: 13px;
    }

    .picker-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 4px;
        padding: 8px;
    }

    .picker-cell {
        min-height: 30px;
        border-radius: 8px;
        border: 1px solid transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .picker-head-day {
        color: var(--text-secondary);
        min-height: 20px;
        font-size: 11px;
        text-transform: uppercase;
    }

    .picker-day {
        cursor: pointer;
        color: #dcfce7;
        background: rgba(34, 197, 94, 0.14);
        border-color: rgba(34, 197, 94, 0.3);
    }

    .picker-day.busy {
        background: rgba(239, 68, 68, 0.22);
        border-color: rgba(239, 68, 68, 0.48);
        color: #fecaca;
    }

    .picker-day.busy.maintenance {
        background: rgba(234, 179, 8, 0.26);
        border-color: rgba(234, 179, 8, 0.46);
        color: #fef3c7;
    }

    .picker-day-other {
        opacity: 0.25;
        cursor: default;
    }

    .picker-day-selected {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
        font-weight: 700;
    }

    .picker-day-between {
        box-shadow: inset 0 0 0 2px rgba(59, 130, 246, 0.26);
    }

    .picker-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        border-top: 1px solid var(--border);
        padding: 12px 16px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .booking-grid {
            grid-template-columns: 1fr;
        }

        .booking-summary {
            position: static;
            top: auto;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .booking-header h1 {
            font-size: 24px;
        }

        .picker-calendars {
            grid-template-columns: 1fr;
        }

        .picker-nav {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="booking-container">
    <div class="booking-header">
        <h1>Đặt xe ngay</h1>
        <p>Điền thông tin để hoàn tất đặt xe của bạn</p>
    </div>

    <form asp-action="Create" asp-controller="Rental" method="post" class="booking-form-wrapper">
        <input asp-for="VehicleId" type="hidden" />
        <div class="booking-grid">
            <!-- Main Form -->
            <div class="booking-form">
                <!-- Vehicle Info -->
                <div class="form-section">
                    <div class="form-section-title">📍 Thông tin xe</div>
                    <div class="info-box">
                        Thông tin xe đã được chọn sẵn. Bạn chỉ cần chọn ngày thuê và nhập thông tin tài xế.
                    </div>
                </div>

                <!-- Rental Dates -->
                <div class="form-section">
                    <div class="form-section-title">📅 Ngày thuê</div>
                    <div class="form-row full">
                        <div class="form-group">
                            <label>Khoảng ngày thuê</label>
                            <button id="openBookingDatePicker" type="button" class="date-picker-trigger">
                                @(Model.StartDate.Year > 1 && Model.EndDate.Year > 1
                                    ? $"{Model.StartDate:dd/MM/yyyy} - {Model.EndDate:dd/MM/yyyy}"
                                    : "Chọn từ ngày đến ngày")
                            </button>
                            <input asp-for="StartDate" type="hidden" id="startDate" value="@(Model.StartDate.Year > 1 ? Model.StartDate.ToString("yyyy-MM-dd") : string.Empty)" />
                            <input asp-for="EndDate" type="hidden" id="endDate" value="@(Model.EndDate.Year > 1 ? Model.EndDate.ToString("yyyy-MM-dd") : string.Empty)" />
                            <span asp-validation-for="StartDate" class="error-message"></span>
                            <span asp-validation-for="EndDate" class="error-message"></span>
                        </div>
                    </div>
                    <div id="bookingBusyAlert" class="booking-alert">Xe đang bận hoặc đang trong ngày bảo dưỡng (+1) theo lịch thuê hiện có.</div>
                    <div class="info-box">
                        Tối thiểu 24 giờ thuê. Phí hủy phụ thuộc vào thời gian hủy.
                    </div>
                </div>

                <!-- Driver Info -->
                <div class="form-section">
                    <div class="form-section-title">👤 Thông tin tài xế</div>
                    <div class="form-row full">
                        <div class="form-group">
                            <label for="driverName">Tên tài xế</label>
                            <input type="text" id="driverName" name="driverName" placeholder="Nhập tên tài xế" required />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="driverPhone">Số điện thoại</label>
                            <input type="tel" id="driverPhone" name="driverPhone" placeholder="0123456789" pattern="[0-9]{10}" required />
                        </div>
                        <div class="form-group">
                            <label for="driverEmail">Email</label>
                            <input type="email" id="driverEmail" name="driverEmail" placeholder="example@email.com" required />
                        </div>
                    </div>
                    <div class="form-row full">
                        <div class="form-group">
                            <label for="licensePlate">Số giấy phép lái xe</label>
                            <input type="text" id="licensePlate" name="licensePlate" placeholder="Nhập số giấy phép" required />
                        </div>
                    </div>
                </div>

                <!-- Pickup Location -->
                <div class="form-section">
                    <div class="form-section-title">🚗 Địa điểm nhận xe</div>
                    <div class="form-row full">
                        <div class="form-group">
                            <label for="pickupLocation">Chọn địa điểm nhận</label>
                            <select name="pickupLocation" id="pickupLocation" required>
                                <option value="">-- Chọn địa điểm --</option>
                                <option value="hcm_center">TP HCM - Trung tâm</option>
                                <option value="hcm_airport">TP HCM - Tân Sơn Nhất</option>
                                <option value="hcm_dong">TP HCM - Quận Đông</option>
                                <option value="hcm_west">TP HCM - Quận Tây</option>
                            </select>
                        </div>
                    </div>
                    <div class="info-box">
                        Nhân viên sẽ giao xe tại địa điểm bạn chọn
                    </div>
                </div>

                <!-- Additional Services -->
                <div class="form-section">
                    <div class="form-section-title">🎁 Dịch vụ bổ sung</div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="insurance" name="AddInsurance" value="true" />
                        <label for="insurance">Bảo hiểm bổ sung (+5%/ngày)</label>
                    </div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="gps" name="AddGPS" value="true" />
                        <label for="gps">GPS định vị (+50.000đ/ngày)</label>
                    </div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="driver" name="IncludeDriver" value="true" />
                        <label for="driver">Thuê thêm tài xế (+200.000đ/ngày)</label>
                    </div>
                </div>

                <!-- Special Requests -->
                <div class="form-section">
                    <div class="form-section-title">💬 Yêu cầu đặc biệt</div>
                    <div class="form-row full">
                        <div class="form-group">
                            <label for="notes">Ghi chú thêm</label>
                            <textarea name="notes" id="notes" placeholder="Thêm bất kỳ yêu cầu đặc biệt nào..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Terms -->
                <div class="form-section">
                    <div class="checkbox-group">
                        <input type="checkbox" id="terms" name="AcceptTerms" value="true" required />
                        <label for="terms">
                            Tôi đã đọc và đồng ý với 
                            <a href="#" style="color: var(--accent); text-decoration: none;">điều khoản sử dụng</a> 
                            và 
                            <a href="#" style="color: var(--accent); text-decoration: none;">chính sách bảo mật</a>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Sidebar Summary -->
            <div class="booking-summary">
                <div class="summary-title">Tóm tắt đặt phòng</div>

                <div class="vehicle-summary">
                    <div class="vehicle-image">🚗</div>
                    <div class="vehicle-name">@vehicleName</div>
                    <div style="font-size:13px; color: var(--text-secondary); margin-bottom:8px;">@vehicleBrand • @vehicleType</div>
                    <div class="vehicle-price">@pricePerDay.ToString("N0")đ/ngày</div>
                </div>

                <div class="summary-row">
                    <label>Ngày thuê:</label>
                    <span id="daysCount">1</span>
                </div>

                <div class="summary-row">
                    <label>Giá/ngày:</label>
                    <span id="pricePerDayText">@pricePerDay.ToString("N0")đ</span>
                </div>

                <div class="summary-row">
                    <label>Tiền cơ bản:</label>
                    <span id="basePrice">2.500.000đ</span>
                </div>

                <div class="summary-row">
                    <label>Phí dịch vụ:</label>
                    <span id="servicefee">0đ</span>
                </div>

                <div class="summary-row">
                    <label>Phí bảo hiểm:</label>
                    <span id="insuranceFee">0đ</span>
                </div>

                <div class="summary-row total">
                    <label>Tổng cộng:</label>
                    <span id="totalPrice">@pricePerDay.ToString("N0")đ</span>
                </div>

                <div class="btn-group">
                    <button type="submit" class="btn btn-primary">
                        ✓ Xác nhận đặt xe
                    </button>
                    <a href="/Rental/Details/@Model.VehicleId" class="btn btn-secondary">
                        ← Quay lại
                    </a>
                </div>

                <div class="info-box" style="margin-top: 20px; margin-bottom: 0;">
                    <strong>Lưu ý:</strong> Thanh toán sẽ được thực hiện trên trang thanh toán tiếp theo
                </div>
            </div>
        </div>
    </form>
</div>

<div id="bookingDatePickerModal" class="picker-modal" aria-hidden="true">
    <div class="picker-modal-card" role="dialog" aria-modal="true" aria-labelledby="bookingDatePickerTitle">
        <div class="picker-head">
            <h3 id="bookingDatePickerTitle" style="font-size:16px; margin:0;">Chọn khoảng ngày thuê</h3>
            <button type="button" class="btn btn-secondary" id="closeBookingDatePicker">Đóng</button>
        </div>
        <div class="picker-body">
            <div class="picker-summary">
                <div class="picker-point">Từ ngày<strong id="bookingSelectedStart">Chưa chọn</strong></div>
                <div class="picker-point">Đến ngày<strong id="bookingSelectedEnd">Chưa chọn</strong></div>
            </div>
            <div class="picker-nav">
                <span id="bookingPickerWindowLabel" class="picker-nav-label">Đang xem tháng hiện tại và tháng kế tiếp</span>
                <div style="display:flex; gap:8px;">
                    <button type="button" id="bookingPickerPrev" class="btn btn-secondary">Back</button>
                    <button type="button" id="bookingPickerNext" class="btn btn-secondary">Next</button>
                </div>
            </div>
            <div id="bookingPickerCalendars" class="picker-calendars"></div>
        </div>
        <div class="picker-actions">
            <button type="button" class="btn btn-secondary" id="bookingPickerClear">Bỏ chọn ngày</button>
            <button type="button" class="btn btn-primary" id="bookingPickerApply">Xong</button>
        </div>
    </div>
</div>

<script>
    const pricePerDay = @pricePerDay;
    const blockedRanges = @Html.Raw(Json.Serialize(((IReadOnlyList<ChoThueXe.Models.Portal.RentalDateRange>?)ViewBag.RentalDates ?? Array.Empty<ChoThueXe.Models.Portal.RentalDateRange>()).Select(x => new {
        startDate = x.StartDate.ToString("yyyy-MM-dd"),
        endDate = x.EndDate.ToString("yyyy-MM-dd")
    })));

    const bookingRangeState = {
        start: document.getElementById('startDate')?.value || '',
        end: document.getElementById('endDate')?.value || '',
        monthOffset: 0
    };

    function parseDate(value) {
        const [year, month, day] = (value || '').split('-').map(Number);
        if (!year || !month || !day) {
            return null;
        }

        const dt = new Date(year, month - 1, day);
        dt.setHours(0, 0, 0, 0);
        return dt;
    }

    function dateKey(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function formatDateDisplay(value) {
        if (!value) {
            return 'Chưa chọn';
        }
        const [y, m, d] = value.split('-');
        return `${d}/${m}/${y}`;
    }

    function isBusyDay(date) {
        return blockedRanges.some(range => {
            const start = parseDate(range.startDate);
            const end = parseDate(range.endDate);
            if (!start || !end) {
                return false;
            }

            return date >= start && date <= end;
        });
    }

    function isMaintenanceDay(date) {
        return blockedRanges.some(range => {
            const end = parseDate(range.endDate);
            if (!end) {
                return false;
            }

            const maintenance = new Date(end);
            maintenance.setDate(maintenance.getDate() + 1);
            return dateKey(maintenance) === dateKey(date);
        });
    }

    function hasOverlapWithBlocked(startDate, endDate) {
        if (!startDate || !endDate) {
            return false;
        }

        return blockedRanges.some(range => {
            const start = parseDate(range.startDate);
            const end = parseDate(range.endDate);
            if (!start || !end) {
                return false;
            }

            end.setDate(end.getDate() + 1);
            return start <= endDate && end >= startDate;
        });
    }

    function refreshBookingDisplay() {
        const trigger = document.getElementById('openBookingDatePicker');
        const startEl = document.getElementById('bookingSelectedStart');
        const endEl = document.getElementById('bookingSelectedEnd');
        if (trigger) {
            trigger.textContent = bookingRangeState.start && bookingRangeState.end
                ? `${formatDateDisplay(bookingRangeState.start)} - ${formatDateDisplay(bookingRangeState.end)}`
                : 'Chọn từ ngày đến ngày';
        }
        if (startEl) {
            startEl.textContent = formatDateDisplay(bookingRangeState.start);
        }
        if (endEl) {
            endEl.textContent = formatDateDisplay(bookingRangeState.end);
        }

        const hiddenStart = document.getElementById('startDate');
        const hiddenEnd = document.getElementById('endDate');
        if (hiddenStart) {
            hiddenStart.value = bookingRangeState.start;
        }
        if (hiddenEnd) {
            hiddenEnd.value = bookingRangeState.end;
        }
    }

    function updateCalculation() {
        const startDate = parseDate(bookingRangeState.start);
        const endDate = parseDate(bookingRangeState.end);

        const daysCount = document.getElementById('daysCount');
        const basePrice = document.getElementById('basePrice');
        const totalPrice = document.getElementById('totalPrice');
        const busyAlert = document.getElementById('bookingBusyAlert');
        const submitButton = document.querySelector('button[type="submit"].btn-primary');

        const days = startDate && endDate && endDate >= startDate
            ? Math.max(1, Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24)))
            : 1;

        let total = days * Number(pricePerDay || 0);

        if (document.getElementById('insurance')?.checked) {
            total += days * (Number(pricePerDay || 0) * 0.05);
        }
        if (document.getElementById('gps')?.checked) {
            total += days * 50000;
        }
        if (document.getElementById('driver')?.checked) {
            total += days * 200000;
        }

        if (daysCount) {
            daysCount.textContent = String(days);
        }
        if (basePrice) {
            basePrice.textContent = (days * Number(pricePerDay || 0)).toLocaleString('vi-VN') + 'đ';
        }
        if (totalPrice) {
            totalPrice.textContent = total.toLocaleString('vi-VN') + 'đ';
        }

        const isBlocked = startDate && endDate && hasOverlapWithBlocked(startDate, endDate);
        if (busyAlert) {
            busyAlert.classList.toggle('show', Boolean(isBlocked));
        }
        if (submitButton) {
            submitButton.disabled = Boolean(isBlocked);
            submitButton.style.opacity = isBlocked ? '0.6' : '1';
            submitButton.style.cursor = isBlocked ? 'not-allowed' : 'pointer';
        }
    }

    function buildPickerMonth(year, month) {
        const monthElement = document.createElement('div');
        monthElement.className = 'picker-month';

        const monthHeader = document.createElement('div');
        monthHeader.className = 'picker-month-head';
        monthHeader.textContent = new Date(year, month, 1).toLocaleDateString('vi-VN', { month: 'long', year: 'numeric' });
        monthElement.appendChild(monthHeader);

        const grid = document.createElement('div');
        grid.className = 'picker-grid';
        ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'].forEach(day => {
            const head = document.createElement('div');
            head.className = 'picker-cell picker-head-day';
            head.textContent = day;
            grid.appendChild(head);
        });

        const firstDay = new Date(year, month, 1);
        const start = new Date(firstDay);
        start.setDate(start.getDate() - firstDay.getDay());

        const selectedStart = parseDate(bookingRangeState.start);
        const selectedEnd = parseDate(bookingRangeState.end);

        for (let i = 0; i < 42; i++) {
            const current = new Date(start);
            current.setDate(start.getDate() + i);
            const key = dateKey(current);

            const cell = document.createElement('button');
            cell.type = 'button';
            cell.className = 'picker-cell picker-day';
            cell.textContent = String(current.getDate());

            if (current.getMonth() !== month) {
                cell.classList.add('picker-day-other');
            }

            if (isBusyDay(current)) {
                cell.classList.add('busy');
                cell.title = `${key}: Đã có hợp đồng`;
            }
            if (isMaintenanceDay(current)) {
                cell.classList.add('busy', 'maintenance');
                cell.title = `${key}: Bảo dưỡng (+1)`;
            }

            if (selectedStart && key === dateKey(selectedStart)) {
                cell.classList.add('picker-day-selected');
            }
            if (selectedEnd && key === dateKey(selectedEnd)) {
                cell.classList.add('picker-day-selected');
            }
            if (selectedStart && selectedEnd && current > selectedStart && current < selectedEnd) {
                cell.classList.add('picker-day-between');
            }

            cell.addEventListener('click', () => {
                const hasStart = Boolean(bookingRangeState.start);
                const hasEnd = Boolean(bookingRangeState.end);
                if (!hasStart || (hasStart && hasEnd)) {
                    bookingRangeState.start = key;
                    bookingRangeState.end = '';
                } else {
                    if (key >= bookingRangeState.start) {
                        bookingRangeState.end = key;
                    } else {
                        bookingRangeState.end = bookingRangeState.start;
                        bookingRangeState.start = key;
                    }
                }

                refreshBookingDisplay();
                renderBookingCalendars();
                updateCalculation();
            });

            grid.appendChild(cell);
        }

        monthElement.appendChild(grid);
        return monthElement;
    }

    function renderBookingCalendars() {
        const wrapper = document.getElementById('bookingPickerCalendars');
        const label = document.getElementById('bookingPickerWindowLabel');
        const prevButton = document.getElementById('bookingPickerPrev');
        if (!wrapper) {
            return;
        }

        wrapper.innerHTML = '';
        const base = new Date();
        base.setDate(1);
        const startMonth = new Date(base.getFullYear(), base.getMonth() + bookingRangeState.monthOffset, 1);
        const endMonth = new Date(base.getFullYear(), base.getMonth() + bookingRangeState.monthOffset + 1, 1);

        if (label) {
            label.textContent = `${startMonth.toLocaleDateString('vi-VN', { month: 'long', year: 'numeric' })} - ${endMonth.toLocaleDateString('vi-VN', { month: 'long', year: 'numeric' })}`;
        }
        if (prevButton) {
            prevButton.disabled = bookingRangeState.monthOffset <= 0;
        }

        for (let i = 0; i < 2; i++) {
            const target = new Date(base.getFullYear(), base.getMonth() + bookingRangeState.monthOffset + i, 1);
            wrapper.appendChild(buildPickerMonth(target.getFullYear(), target.getMonth()));
        }
    }

    function openBookingDatePicker() {
        const modal = document.getElementById('bookingDatePickerModal');
        if (!modal) {
            return;
        }

        bookingRangeState.monthOffset = 0;
        refreshBookingDisplay();
        renderBookingCalendars();
        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
    }

    function closeBookingDatePicker() {
        const modal = document.getElementById('bookingDatePickerModal');
        if (!modal) {
            return;
        }

        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
    }

    document.getElementById('openBookingDatePicker')?.addEventListener('click', openBookingDatePicker);
    document.getElementById('closeBookingDatePicker')?.addEventListener('click', closeBookingDatePicker);
    document.getElementById('bookingPickerNext')?.addEventListener('click', () => {
        bookingRangeState.monthOffset += 1;
        renderBookingCalendars();
    });
    document.getElementById('bookingPickerPrev')?.addEventListener('click', () => {
        if (bookingRangeState.monthOffset <= 0) {
            return;
        }
        bookingRangeState.monthOffset -= 1;
        renderBookingCalendars();
    });
    document.getElementById('bookingPickerClear')?.addEventListener('click', () => {
        bookingRangeState.start = '';
        bookingRangeState.end = '';
        refreshBookingDisplay();
        renderBookingCalendars();
        updateCalculation();
    });
    document.getElementById('bookingPickerApply')?.addEventListener('click', () => {
        if (bookingRangeState.start && !bookingRangeState.end) {
            bookingRangeState.end = bookingRangeState.start;
        }
        refreshBookingDisplay();
        updateCalculation();
        closeBookingDatePicker();
    });

    document.getElementById('bookingDatePickerModal')?.addEventListener('click', (event) => {
        if (event.target?.id === 'bookingDatePickerModal') {
            closeBookingDatePicker();
        }
    });

    document.getElementById('insurance')?.addEventListener('change', updateCalculation);
    document.getElementById('gps')?.addEventListener('change', updateCalculation);
    document.getElementById('driver')?.addEventListener('change', updateCalculation);

    refreshBookingDisplay();
    updateCalculation();
</script>
