<script>
    function updatePrice(slider) {
        const value = parseInt(slider.value).toLocaleString('vi-VN');
        document.getElementById('priceValue').textContent = value + 'đ';
    }

    function sortResults(value) {
        console.log('Sorting by:', value);
    }
</script>
