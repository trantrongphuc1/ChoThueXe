                <label for="suv">SUV</label>
            </div>
            <div class="filter-item">
                <input type="checkbox" id="van" checked>
                <label for="van">Van/Minibus</label>
            </div>
            <div class="filter-item">
                <input type="checkbox" id="luxury">
                <label for="luxury">Xe sang</label>
            </div>
        </div>

        <!-- Transmission -->
        <div class="filter-group">
            <div class="filter-title">⚙️ Hộp số</div>
            <div class="filter-item">
