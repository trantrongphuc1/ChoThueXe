            </div>
            <div class="filter-item">
                <input type="checkbox" id="hybrid">
                <label for="hybrid">Hybrid</label>
            </div>
        </div>

        <!-- Rating -->
        <div class="filter-group">
            <div class="filter-title">⭐ Đánh giá</div>
            <div class="filter-item">
                <input type="checkbox" id="rating5" checked>
                <label for="rating5">5 sao (125)</label>
            </div>
            <div class="filter-item">
                <input type="checkbox" id="rating4" checked>
                <label for="rating4">4+ sao (312)</label>
            </div>
            <div class="filter-item">
                <input type="checkbox" id="rating3">
                <label for="rating3">3+ sao (48)</label>
            </div>
        </div>
    </div>

