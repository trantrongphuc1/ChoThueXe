@{
    ViewData["Title"] = "Chi tiết xe";
}

<style>
    :root {
        --bg-primary: #0f1117;
        --bg-secondary: #161b27;
        --bg-tertiary: #21262d;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --border: #30363d;
        --text-primary: #e2e8f0;
        --text-secondary: #8b949e;
        --success: #3fb950;
        --danger: #f85149;
        --warning: #fbbf24;
        --radius: 12px;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .detail-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 32px;
        margin-bottom: 40px;
    }

    .gallery {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .main-image {
        width: 100%;
        height: 400px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.1) 100%);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 100px;
        border: 1px solid var(--border);
    }

    .thumbnails {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }

    .thumbnail {
        width: 100%;
        height: 80px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(59, 130, 246, 0.08) 100%);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 1px solid var(--border);
        transition: all 0.2s ease;
        font-size: 32px;
    }

    .thumbnail:hover {
        border-color: var(--accent);
    }

    .detail-sidebar {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .booking-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
        position: sticky;
        top: 100px;
    }

    .price-display {
        font-size: 32px;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 4px;
    }

    .price-unit {
        font-size: 12px;
        color: var(--text-secondary);
        font-weight: 400;
    }

    .booking-btn {
        width: 100%;
        padding: 12px;
        background-color: var(--accent);
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }

    .booking-btn:hover {
        background-color: var(--accent-hover);
    }

    .info-box {
        background-color: var(--bg-tertiary);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 12px;
        font-size: 13px;
    }

    .info-box-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }

    .info-box-item:last-child {
        border-bottom: none;
    }

    .info-box-label {
        color: var(--text-secondary);
    }

    .info-box-value {
        color: var(--text-primary);
        font-weight: 600;
    }

    .detail-content {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .vehicle-header {
        flex: 1;
    }

    .vehicle-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .vehicle-badges {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .badge {
        background-color: rgba(59, 130, 246, 0.1);
        color: var(--accent);
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .vehicle-rating-large {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
    }

    .rating-stars {
        color: var(--warning);
        font-size: 16px;
    }

    .heart-btn {
        width: 40px;
        height: 40px;
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .heart-btn:hover {
        background-color: rgba(248, 81, 73, 0.1);
        border-color: var(--danger);
    }

    .section-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--accent);
        display: inline-block;
    }

    .specs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .spec-item {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 16px;
        text-align: center;
    }

    .spec-icon {
        font-size: 32px;
        margin-bottom: 8px;
    }

    .spec-label {
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

    .spec-value {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
    }

    .feature-item {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
    }

    .feature-icon {
        font-size: 20px;
    }

    .reviews-section {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
    }

    .review-card {
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border);
    }

    .review-card:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .review-name {
        font-weight: 600;
        color: var(--text-primary);
    }

    .review-rating {
        color: var(--warning);
    }

    .review-date {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .review-text {
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }

        .booking-card {
            position: static;
        }

        .vehicle-title {
            font-size: 24px;
        }

        .specs-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .thumbnails {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

<div class="detail-container">
    <!-- Gallery & Booking -->
    <div class="detail-grid">
        <!-- Gallery -->
        <div class="gallery">
            <div class="main-image">🚗</div>
            <div class="thumbnails">
                <div class="thumbnail">🚗</div>
                <div class="thumbnail">🚗</div>
                <div class="thumbnail">🚗</div>
                <div class="thumbnail">🚗</div>
            </div>
        </div>

        <!-- Booking Card -->
        <div class="detail-sidebar">
            <div class="booking-card">
                <div class="price-display">
                    2.500.000đ
                    <span class="price-unit">/ngày</span>
                </div>
                <div style="display: flex; gap: 8px; margin-bottom: 16px; font-size: 13px;">
                    <div style="flex: 1;">
                        <div style="color: var(--text-secondary); margin-bottom: 4px;">Giá tuần</div>
                        <div style="font-weight: 700;">17.250.000đ</div>
                    </div>
                    <div style="flex: 1;">
                        <div style="color: var(--text-secondary); margin-bottom: 4px;">Giá tháng</div>
                        <div style="font-weight: 700;">75.000.000đ</div>
                    </div>
                </div>

                <a href="/Rental/Book" class="booking-btn">📅 Đặt ngay</a>

                <div class="info-box">
                    <div class="info-box-item">
                        <span class="info-box-label">📍 Địa điểm</span>
                        <span class="info-box-value">TP. Hồ Chí Minh</span>
                    </div>
                    <div class="info-box-item">
                        <span class="info-box-label">📅 Sẵn từ</span>
                        <span class="info-box-value">01/04/2026</span>
                    </div>
                    <div class="info-box-item">
                        <span class="info-box-label">⭐ Đánh giá</span>
                        <span class="info-box-value">4.8/5 (324)</span>
                    </div>
                    <div class="info-box-item">
                        <span class="info-box-label">✅ Trạng thái</span>
                        <span class="info-box-value" style="color: var(--success);">Sẵn sàng</span>
                    </div>
                </div>
            </div>

            <div class="booking-card" style="padding: 16px;">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 12px;">Chủ xe</div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 48px; height: 48px; background-color: var(--bg-tertiary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px;">👤</div>
                    <div>
                        <div style="font-weight: 600; font-size: 13px;">Nguyễn Văn A</div>
                        <div style="font-size: 12px; color: var(--text-secondary);">Thành viên 2 năm</div>
                        <div style="font-size: 11px; color: var(--success); margin-top: 4px;">✓ Xác minh</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Content -->
    <div class="detail-content">
        <!-- Header -->
        <div class="detail-header">
            <div class="vehicle-header">
                <h1 class="vehicle-title">Toyota Camry 2024</h1>
                <div class="vehicle-badges">
                    <div class="badge">Tự động</div>
                    <div class="badge">Xăng</div>
                    <div class="badge">Mới</div>
                </div>
                <div class="vehicle-rating-large">
                    <span class="rating-stars">⭐⭐⭐⭐⭐</span>
                    <span>4.8/5 từ 324 đánh giá</span>
                </div>
            </div>
            <button class="heart-btn" onclick="toggleFav(this)">🤍</button>
        </div>

        <!-- Specifications -->
        <div>
            <h2 class="section-title">📋 Thông số kỹ thuật</h2>
            <div class="specs-grid">
                <div class="spec-item">
                    <div class="spec-icon">📅</div>
                    <div class="spec-label">Năm sản xuất</div>
                    <div class="spec-value">2024</div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon">⚙️</div>
                    <div class="spec-label">Hộp số</div>
                    <div class="spec-value">Tự động</div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon">⛽</div>
                    <div class="spec-label">Loại nhiên liệu</div>
                    <div class="spec-value">Xăng</div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon">👥</div>
                    <div class="spec-label">Số chỗ</div>
                    <div class="spec-value">5 chỗ</div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon">💪</div>
                    <div class="spec-label">Công suất</div>
                    <div class="spec-value">203 HP</div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon">🛣️</div>
                    <div class="spec-label">Quãng đường</div>
                    <div class="spec-value">5,234 km</div>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div>
            <h2 class="section-title">🎯 Tính năng & Tiện nghi</h2>
            <div class="features-grid">
                <div class="feature-item">
                    <span class="feature-icon">🎵</span>
                    <span>Hệ thống âm thanh</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">📱</span>
                    <span>Apple CarPlay</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">❄️</span>
                    <span>Điều hòa tự động</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">📡</span>
                    <span>GPS Navigation</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">🔐</span>
                    <span>Khóa thông minh</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">☀️</span>
                    <span>Cửa sổ trời</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">🚗</span>
                    <span>Camera lùi</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">⚡</span>
                    <span>Cửa USB</span>
                </div>
            </div>
        </div>

        <!-- Description -->
        <div>
            <h2 class="section-title">📝 Mô tả</h2>
            <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.8;">
                Toyota Camry 2024 là chiếc sedan hạng trung hàng đầu với hiệu suất mượt mà, tiêu thụ nhiên liệu thấp và nội thất sang trọng. Xe được bảo dưỡng tốt, không có tai nạn và sẵn sàng cho những chuyến đi dài.
            </p>
        </div>

        <!-- Rules -->
        <div>
            <h2 class="section-title">⚙️ Quy tắc cho chủ xe</h2>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                    <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">✓ Được phép</div>
                    <div style="font-size: 13px;">Hút thuốc ở ngoài</div>
                </div>
                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                    <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">✗ Không được phép</div>
                    <div style="font-size: 13px;">Hút thuốc trong xe</div>
                </div>
                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                    <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">✓ Được phép</div>
                    <div style="font-size: 13px;">Mang thú cưng</div>
                </div>
                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                    <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">✗ Không được phép</div>
                    <div style="font-size: 13px;">Lái dưới ảnh hưởng</div>
                </div>
            </div>
        </div>

        <!-- Reviews -->
        <div class="reviews-section">
            <h2 class="section-title">⭐ Đánh giá</h2>
            
            <div class="review-card">
                <div class="review-header">
                    <div>
                        <div class="review-name">👤 Nguyễn Văn B</div>
                        <div class="review-date">15 ngày trước</div>
                    </div>
                    <div class="review-rating">⭐⭐⭐⭐⭐</div>
                </div>
                <div class="review-text">
                    Chiếc xe rất tốt, sạch sẽ và an toàn. Chủ xe rất thân thiện. Sẽ thuê lại!
                </div>
            </div>

            <div class="review-card">
                <div class="review-header">
                    <div>
                        <div class="review-name">👤 Trần Thị C</div>
                        <div class="review-date">1 tháng trước</div>
                    </div>
                    <div class="review-rating">⭐⭐⭐⭐</div>
                </div>
                <div class="review-text">
                    Tốt, nhưng có một vài vết xước nhỏ. Chủ xe đã xử lý rất chuyên nghiệp.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleFav(element) {
        element.textContent = element.textContent === '🤍' ? '❤️' : '🤍';
    }
</script>
