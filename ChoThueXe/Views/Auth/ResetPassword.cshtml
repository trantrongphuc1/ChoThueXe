@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<h2>Đặt lại mật khẩu</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="ResetPassword" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" name="email" required />
    </div>
    <div class="mb-3">
        <label for="otpCode" class="form-label">OTP</label>
        <input type="text" class="form-control" id="otpCode" name="otpCode" required />
    </div>
    <div class="mb-3">
        <label for="newPassword" class="form-label">Mật khẩu mới</label>
        <input type="password" class="form-control" id="newPassword" name="newPassword" required />
    </div>
    <button type="submit" class="btn btn-primary">Đặt lại mật khẩu</button>
</form>
