@model ChoThueXe.Models.Portal.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Nhân viên - Tạo hợp đồng";
}

<h2 class="mb-3">Nhân viên: Tạo hợp đồng draft</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Mục lục nhanh</div>
    <div class="card-body d-flex gap-2 flex-wrap">
        <a href="#tao-hop-dong" class="btn btn-outline-primary btn-sm">Tạo hợp đồng</a>
        <a href="#danh-sach-khach" class="btn btn-outline-secondary btn-sm">Danh sách khách hàng</a>
        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-dark btn-sm">Trang khách hàng</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div id="tao-hop-dong" class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Tạo hợp đồng (sp_create_contract)</div>
    <div class="card-body">
        <form asp-action="CreateDraft" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label class="form-label">Chọn khách hàng</label>
                <select class="form-select" name="CustomerId" required>
                    <option value="">-- Chọn khách hàng --</option>
                    @foreach (var c in Model.Customers)
                    {
                        <option value="@c.UserId">@c.UserId - @c.FullName (@(c.IsVerified ? "Verified" : "Chưa verified"))</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Tạo hợp đồng</button>
            </div>
        </form>
    </div>
</div>

<div id="danh-sach-khach" class="card shadow-sm">
    <div class="card-header fw-semibold">Danh sách khách hàng</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Trạng thái xác minh</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Customers)
            {
                <tr>
                    <td>@c.UserId</td>
                    <td>@c.FullName</td>
                    <td>@c.Email</td>
                    <td>
                        @if (c.IsVerified)
                        {
                            <span class="badge text-bg-success">APPROVED</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">PENDING</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
