                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Chỗ ngồi</div>
                        <div class="detail-value">5 chỗ</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Đơn hoạt động</div>
                        <div class="detail-value">8</div>
                    </div>
                </div>
                <div class="vehicle-actions">
                    <a href="#" class="btn btn-secondary" title="Chỉnh sửa">✏️ Sửa</a>
