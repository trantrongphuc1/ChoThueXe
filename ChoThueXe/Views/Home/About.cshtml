@{
    ViewData["Title"] = "Về chúng tôi";
}

<style>
    :root {
        --bg-primary: #0f1117;
        --bg-secondary: #161b27;
        --bg-tertiary: #21262d;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --border: #30363d;
        --text-primary: #e2e8f0;
        --text-secondary: #8b949e;
        --success: #3fb950;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .about-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .hero-section {
        text-align: center;
        padding: 80px 20px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
        border-radius: 16px;
        margin-bottom: 60px;
        margin-top: 40px;
    }

    .hero-section h1 {
        font-size: 48px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .hero-section p {
        font-size: 18px;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 60px;
    }

    .stat-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 30px;
        text-align: center;
    }

    .stat-icon {
        font-size: 40px;
        margin-bottom: 12px;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: 14px;
        color: var(--text-secondary);
    }

    .section {
        margin-bottom: 60px;
    }

    .section-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--border);
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
        margin-bottom: 40px;
    }

    .content-grid.reverse {
        direction: rtl;
    }

    .content-grid.reverse > * {
        direction: ltr;
    }

    .content-text h3 {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .content-text p {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 16px;
    }

    .content-image {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.1) 100%);
        border-radius: 12px;
        padding: 60px 40px;
        text-align: center;
        font-size: 80px;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .value-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 30px;
        text-align: center;
    }

    .value-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .value-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 12px;
    }

    .value-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }

    .team-member {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    .member-avatar {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .member-name {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .member-role {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .cta-section {
        background-color: var(--bg-secondary);
        border: 2px solid var(--accent);
        border-radius: 16px;
        padding: 60px 40px;
        text-align: center;
    }

    .cta-section h2 {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .cta-section p {
        font-size: 16px;
        color: var(--text-secondary);
        margin-bottom: 24px;
    }

    .btn {
        display: inline-block;
        padding: 12px 32px;
        background-color: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn:hover {
        background-color: var(--accent-hover);
    }

    @@media (max-width: 1024px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .values-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .team-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .hero-section {
            padding: 40px 20px;
        }

        .hero-section h1 {
            font-size: 32px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .values-grid,
        .team-grid {
            grid-template-columns: 1fr;
        }

        .section-title {
            font-size: 24px;
        }

        .cta-section {
            padding: 40px 20px;
        }

        .cta-section h2 {
            font-size: 22px;
        }
    }
</style>

<div class="about-container">
    <!-- Hero Section -->
    <div class="hero-section">
        <h1>🚗 Về ChoThueXe</h1>
        <p>Nền tảng cho thuê xe hàng đầu tại Việt Nam - Kết nối người lái xe với những chiếc xe tuyệt vời</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">🚗</div>
            <div class="stat-number">5,000+</div>
            <div class="stat-label">Chiếc xe</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-number">100,000+</div>
            <div class="stat-label">Khách hàng</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-number">4.8</div>
            <div class="stat-label">Đánh giá trung bình</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🌍</div>
            <div class="stat-number">50+</div>
            <div class="stat-label">Thành phố</div>
        </div>
    </div>

    <!-- Story Section -->
    <div class="section">
        <h2 class="section-title">📖 Câu chuyện của chúng tôi</h2>
        <div class="content-grid">
            <div class="content-text">
                <h3>Bắt đầu từ một ý tưởng đơn giản</h3>
                <p>Vào năm 2020, chúng tôi nhận ra rằng việc cho thuê xe tại Việt Nam quá phức tạp và đắt đỏ. Hầu hết mọi người phải đi qua các trung gian, mất thời gian và tiền bạc.</p>
                <p>Với sứ mệnh làm cho việc cho thuê xe trở nên dễ dàng, an toàn và giá cả hợp lý, ChoThueXe ra đời.</p>
            </div>
            <div class="content-image">📱</div>
        </div>
    </div>

    <!-- Mission Section -->
    <div class="section">
        <h2 class="section-title">🎯 Sứ mệnh & Tầm nhìn</h2>
        <div class="content-grid reverse">
            <div class="content-text">
                <h3>Kết nối người dân với những cuộc phiêu lưu</h3>
                <p><strong>Sứ mệnh:</strong> Cung cấp dịch vụ cho thuê xe an toàn, giá cả hợp lý và tiện lợi cho tất cả mọi người.</p>
                <p><strong>Tầm nhìn:</strong> Trở thành nền tảng cho thuê xe được tin tưởng nhất tại Đông Nam Á.</p>
                <p>Chúng tôi tin rằng mỗi chuyến đi nên là một kỷ niệm tuyệt vời, không phải một nỗi lo lắng.</p>
            </div>
            <div class="content-image">🎯</div>
        </div>
    </div>

    <!-- Values Section -->
    <div class="section">
        <h2 class="section-title">💎 Các giá trị của chúng tôi</h2>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">🤝</div>
                <div class="value-title">Tin tưởng</div>
                <div class="value-desc">Chúng tôi xây dựng mối quan hệ dài hạn dựa trên sự trung thực và minh bạch.</div>
            </div>
            <div class="value-card">
                <div class="value-icon">⚡</div>
                <div class="value-title">Đổi mới</div>
                <div class="value-desc">Luôn tìm cách tốt hơn để phục vụ khách hàng thông qua công nghệ tiên tiến.</div>
            </div>
            <div class="value-card">
                <div class="value-icon">🌟</div>
                <div class="value-title">Chất lượng</div>
                <div class="value-desc">Mỗi chiếc xe được kiểm tra kỹ lưỡng để đảm bảo an toàn và tiện nghi.</div>
            </div>
        </div>
    </div>

    <!-- Team Section -->
    <div class="section">
        <h2 class="section-title">👨‍💼 Đội ngũ của chúng tôi</h2>
        <div class="team-grid">
            <div class="team-member">
                <div class="member-avatar">👨‍💼</div>
                <div class="member-name">Nguyễn Văn A</div>
                <div class="member-role">CEO & Founder</div>
            </div>
            <div class="team-member">
                <div class="member-avatar">👩‍💼</div>
                <div class="member-name">Trần Thị B</div>
                <div class="member-role">CTO</div>
            </div>
            <div class="team-member">
                <div class="member-avatar">👨‍💻</div>
                <div class="member-name">Phạm Văn C</div>
                <div class="member-role">VP Business</div>
            </div>
            <div class="team-member">
                <div class="member-avatar">👩‍💻</div>
                <div class="member-name">Lê Thị D</div>
                <div class="member-role">Head of Operations</div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="cta-section">
        <h2>Sẵn sàng bắt đầu hành trình của bạn?</h2>
        <p>Tìm chiếc xe hoàn hảo cho chuyến đi tiếp theo của bạn ngay hôm nay</p>
        <a href="/Rental/Search" class="btn">🔍 Tìm xe ngay</a>
    </div>
</div>
