@model ChoThueXe.Models.Portal.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
}

<h2 class="mb-3">Admin: Duyệt giấy tở và thêm xe</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Duyệt giấy tở (CCCD/Bằng lái)</div>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                    <tr>
                        <th>Document</th>
                        <th>User</th>
                        <th>Loại</th>
                        <th>Link</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model.PendingDocuments)
                    {
                        <tr>
                            <td>@d.DocumentId</td>
                            <td>@d.UserId - @d.FullName</td>
                            <td>@d.DocType</td>
                            <td>@d.FileUrl</td>
                            <td>@d.Status</td>
                            <td>
                                <form asp-action="ApproveDocument" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="documentId" value="@d.DocumentId" />
                                    <button type="submit" class="btn btn-sm btn-success">Duyệt</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Thêm xe mới</div>
            <div class="card-body">
                <form asp-action="AddVehicle" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OwnerId" value="0" />
                    <div class="col-12">
                        <label class="form-label">Tên xe</label>
                        <input class="form-control" name="VehicleName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hãng xe</label>
                        <select class="form-select" name="BrandId" required>
                            <option value="">-- Chọn --</option>
                            @foreach (var b in Model.Brands)
                            {
                                <option value="@b.BrandId">@b.BrandName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Loại xe</label>
                        <select class="form-select" name="TypeId" required>
                            <option value="">-- Chọn --</option>
                            @foreach (var t in Model.Types)
                            {
                                <option value="@t.TypeId">@t.TypeName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Số chỗ</label>
                        <input class="form-control" name="Seats" type="number" min="2" max="60" value="4" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Hộp số</label>
                        <input class="form-control" name="Transmission" value="Auto" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nhiên liệu</label>
                        <select class="form-select" name="FuelType" required>
                            <option value="">-- Chọn --</option>
                            <option value="Xăng">Xăng</option>
                            <option value="Dầu">Dầu</option>
                            <option value="Điện">Điện</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Giá/ngày</label>
                        <input class="form-control" name="PricePerDay" type="number" step="1000" min="1" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" name="Status">
                            <option value="AVAILABLE">AVAILABLE</option>
                            <option value="MAINTENANCE">MAINTENANCE</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ảnh xe (mỗi URL một dòng)</label>
                        <textarea class="form-control" name="ImageUrls" rows="4" placeholder="https://.../xe-1.jpg&#10;https://.../xe-2.jpg"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label d-block">Tiện nghi sẵn có</label>
                        <div class="row g-2">
                            @foreach (var am in Model.AmenityOptions)
                            {
                                <div class="col-md-6">
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedAmenities" value="@am.Code" />
                                        <span class="form-check-label">@am.Name</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Thêm xe</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Duyệt cập CCCD + Bằng lái theo từng khách hàng</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>User</th>
                <th>CCCD</th>
                <th>DRIVER_LICENSES</th>
                <th>Xử lý</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.PendingVerifications.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">Chưa có bộ giấy tở nào cho duyệt cấp đôi.</td>
                </tr>
            }
            else
            {
                @foreach (var v in Model.PendingVerifications)
                {
                    <tr>
                        <td>@v.UserId - @v.FullName</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(v.CccdFileUrl))
                            {
                                <span class="text-muted">Không có link</span>
                            }
                            else
                            {
                                <a href="@v.CccdFileUrl" target="_blank" rel="noopener">Xem CCCD</a>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(v.DriverLicenseFileUrl))
                            {
                                <span class="text-muted">Không có link</span>
                            }
                            else
                            {
                                <a href="@v.DriverLicenseFileUrl" target="_blank" rel="noopener">Xem bằng lái</a>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="ReviewDocuments" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="UserId" value="@v.UserId" />
                                    <input type="hidden" name="IsMatched" value="true" />
                                    <button type="submit" class="btn btn-sm btn-success">Khớp - Duyệt</button>
                                </form>
                                <form asp-action="ReviewDocuments" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="UserId" value="@v.UserId" />
                                    <input type="hidden" name="IsMatched" value="false" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Không khớp - Từ chối</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Duyệt yêu cầu sửa thông tin cá nhân</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>User</th>
                <th>Thông tin hiện tại</th>
                <th>Thông tin yêu cầu</th>
                <th>Thời gian</th>
                <th>Xử lý</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.PendingProfileUpdates.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted">Chưa có yêu cầu nào.</td>
                </tr>
            }
            else
            {
                @foreach (var p in Model.PendingProfileUpdates)
                {
                    <tr>
                        <td>@p.UserId</td>
                        <td>@p.CurrentFullName - @p.CurrentPhone</td>
                        <td>@p.RequestedFullName - @p.RequestedPhone</td>
                        <td>@p.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="ReviewProfileUpdate" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="RequestId" value="@p.RequestId" />
                                    <input type="hidden" name="IsApproved" value="true" />
                                    <button type="submit" class="btn btn-sm btn-success">Duyệt</button>
                                </form>
                                <form asp-action="ReviewProfileUpdate" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="RequestId" value="@p.RequestId" />
                                    <input type="hidden" name="IsApproved" value="false" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Từ chối</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Hộp thư tin nhắn khách hàng</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>Khách hàng</th>
                <th>Nội dung</th>
                <th>Trạng thái</th>
                <th>Trả lời</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Messages.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">Chưa có tin nhắn nào.</td>
                </tr>
            }
            else
            {
                @foreach (var m in Model.Messages)
                {
                    <tr>
                        <td>@m.SenderName</td>
                        <td>
                            <div>@m.Content</div>
                            <small class="text-muted">@m.SentAt.ToString("yyyy-MM-dd HH:mm")</small>
                        </td>
                        <td>@m.Status</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(m.ReplyContent))
                            {
                                <form asp-action="ReplyMessage" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MessageId" value="@m.MessageId" />
                                    <input class="form-control form-control-sm" name="ReplyContent" placeholder="Nhập phản hồi..." required />
                                    <button type="submit" class="btn btn-sm btn-success">Gửi</button>
                                </form>
                            }
                            else
                            {
                                <div>@m.ReplyContent</div>
                                <small class="text-muted">@m.RepliedAt?.ToString("yyyy-MM-dd HH:mm")</small>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Danh sách xe hiện tại</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Tên xe</th>
                <th>Hãng</th>
                <th>Loại</th>
                <th>Tiện nghi</th>
                <th>Giá/ngày</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var v in Model.Vehicles)
            {
                <tr>
                    <td>@v.VehicleId</td>
                    <td>@v.VehicleName</td>
                    <td>@v.BrandName</td>
                    <td>@v.TypeName</td>
                    <td>@(string.IsNullOrWhiteSpace(v.AmenitiesText) ? "-" : v.AmenitiesText)</td>
                    <td>@v.PricePerDay.ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Quản lý tài khoản</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Họ tên</th>
                        <th>Role</th>
                        <th>Số HD</th>
                        <th>Đã thanh toán</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        <tr>
                            <td>@a.UserId</td>
                            <td>@a.FullName</td>
                            <td>@a.RoleName</td>
                            <td>@a.ContractCount</td>
                            <td>@a.TotalPaid.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Quản lý hợp đồng</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Khách</th>
                        <th>Xe</th>
                        <th>Tổng</th>
                        <th>Trạng thái</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Contracts.Take(30))
                    {
                        <tr>
                            <td>@c.ContractId</td>
                            <td>@c.FullName</td>
                            <td>@c.VehicleName</td>
                            <td>@c.TotalAmount.ToString("N0")</td>
                            <td>@c.Status</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Quản lý xe đang thuê / xe trống</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Xe</th>
                        <th>Status</th>
                        <th>Tình trạng</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in Model.VehicleOccupancies)
                    {
                        <tr>
                            <td>@o.VehicleId</td>
                            <td>@o.VehicleName</td>
                            <td>@o.Status</td>
                            <td>
                                <span class="badge @(o.Occupancy == "DANG_THUE" ? "text-bg-danger" : "text-bg-success")">@o.Occupancy</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Top xe được thuê</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Xe</th>
                        <th>Lượt thuê</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in Model.TopRentedVehicles.Take(10).Select((x, i) => new { Rank = i + 1, Item = x }))
                    {
                        <tr>
                            <td>@t.Rank</td>
                            <td>@t.Item.VehicleName</td>
                            <td>@t.Item.RentCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Dashboard doanh thu theo xe</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                    <tr>
                        <th>Xe</th>
                        <th>Doanh thu</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.RevenueByVehicle.Take(15))
                    {
                        <tr>
                            <td>@r.VehicleName</td>
                            <td>@r.TotalRevenue.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Dashboard doanh thu theo account</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                    <tr>
                        <th>User</th>
                        <th>Tổng doanh thu</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.RevenueByAccount.Take(15))
                    {
                        <tr>
                            <td>@r.UserId - @r.FullName</td>
                            <td>@r.TotalRevenue.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
ALTER TRIGGER TRG_CONTRACT_VALIDATE ENABLE;