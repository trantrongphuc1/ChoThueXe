@model ChoThueXe.Models.Portal.AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản lý xe";
    var vehicleKeywordFilter = (ViewData["VehicleKeywordFilter"] as string) ?? string.Empty;
}

<style>
    .admin-wrap { max-width: 1280px; margin: 24px auto; padding: 0 16px; }
    .admin-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
    .admin-header h1 { margin: 0; font-size: 28px; }
    .panel { border: 1px solid var(--border); border-radius: 12px; background: var(--bg-secondary); margin-bottom: 16px; overflow: hidden; }
    .panel-head { padding: 12px 14px; border-bottom: 1px solid var(--border); font-weight: 700; }
    .panel-body { padding: 12px 14px; }
    .empty { color: var(--text-secondary); }
    .summary { display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-bottom: 14px; }
    .summary-box { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: var(--bg-secondary); }
    .summary-box .label { color: var(--text-secondary); font-size: 12px; }
    .summary-box .value { font-size: 20px; font-weight: 700; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border-bottom: 1px solid var(--border); padding: 8px; text-align: left; vertical-align: top; }
    th { color: var(--text-secondary); font-size: 12px; text-transform: uppercase; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
    .form-control, select, textarea { width: 100%; border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-primary); border-radius: 8px; padding: 8px 10px; }
    .btn { border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-primary); border-radius: 8px; padding: 7px 10px; cursor: pointer; text-decoration: none; }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-danger { background: #b91c1c; border-color: #b91c1c; color: #fff; }
    .small { font-size: 12px; color: var(--text-secondary); }
    .actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .alert { border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; border: 1px solid transparent; }
    .alert-success { background: var(--success-light); border-color: var(--success); color: #14532d; }
    .alert-danger { background: var(--error-light); border-color: var(--error); color: #7f1d1d; }
    .amenity-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px; margin-top: 6px; }
    .amenity-chip { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; background: var(--bg-primary); }
    .amenity-chip input { width: auto; }
    .heatmap-modal { position: fixed; inset: 0; z-index: 1100; display: none; }
    .heatmap-modal.open { display: block; }
    .heatmap-backdrop { position: absolute; inset: 0; background: rgba(15, 17, 23, 0.75); }
    .heatmap-dialog { position: relative; margin: 4vh auto; width: min(1100px, calc(100vw - 24px)); max-height: 92vh; overflow: auto; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-secondary); }
    .heatmap-header { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 12px 14px; border-bottom: 1px solid var(--border); }
    .heatmap-header h3 { margin: 0; font-size: 18px; }
    .heatmap-close { border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-primary); border-radius: 8px; padding: 6px 10px; cursor: pointer; }
    .heatmap-body { padding: 12px 14px; }
    .heatmap-empty { color: var(--text-secondary); margin-bottom: 10px; }
    .heatmap-filter { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
    .heatmap-filter label { color: var(--text-secondary); font-size: 13px; }
    .heatmap-filter select { min-width: 140px; }
    .heatmap-legend { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
    .legend-item { display: flex; gap: 8px; align-items: center; color: var(--text-secondary); font-size: 13px; }
    .legend-color { width: 14px; height: 14px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.15); }
    .calendar-wrap { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 12px; }
    .calendar-month { border: 1px solid var(--border); border-radius: 10px; background: var(--bg-primary); overflow: hidden; }
    .calendar-month-head { display: flex; justify-content: space-between; align-items: center; padding: 9px 10px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--text-secondary); }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; padding: 8px; }
    .calendar-cell { min-height: 30px; border-radius: 7px; border: 1px solid transparent; display: flex; align-items: center; justify-content: center; font-size: 12px; }
    .calendar-head { color: var(--text-secondary); min-height: 20px; font-size: 11px; }
    .day-other { opacity: 0.3; }
    .day-free { background: rgba(34, 197, 94, 0.16); color: #dcfce7; border-color: rgba(34, 197, 94, 0.32); }
    .day-rented { background: rgba(239, 68, 68, 0.22); color: #fecaca; border-color: rgba(239, 68, 68, 0.48); }
    .day-maintenance { background: rgba(234, 179, 8, 0.28); color: #fef3c7; border-color: rgba(234, 179, 8, 0.46); }
    .day-today { outline: 2px solid var(--accent); outline-offset: -2px; font-weight: 700; }
</style>

<div class="admin-wrap">
    <div class="admin-header">
        <h1>Quản lý xe (CRUD)</h1>
        <a class="btn" href="/Home">Về trang chủ</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="summary">
        <div class="summary-box"><div class="label">Tổng xe hiển thị</div><div class="value">@Model.Vehicles.Count</div></div>
        <div class="summary-box"><div class="label">Hãng xe</div><div class="value">@Model.Brands.Count</div></div>
        <div class="summary-box"><div class="label">Loại xe</div><div class="value">@Model.Types.Count</div></div>
    </div>

    <div class="panel">
        <div class="panel-head">Tìm kiếm xe</div>
        <div class="panel-body">
            <form asp-action="VehicleManagement" method="get" class="form-grid">
                <div>
                    <label>Tìm theo tên xe / hãng / loại / biển số / trạng thái</label>
                    <input class="form-control" type="text" name="vehicleQ" value="@vehicleKeywordFilter" placeholder="VD: Camry, Toyota, 30A, AVAILABLE" />
                </div>
                <div style="display:flex; gap:8px; align-items:end;">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    <a asp-action="VehicleManagement" class="btn">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Bước 1 - Tạo danh mục trước khi thêm xe</div>
        <div class="panel-body">
            <div class="form-grid">
                <form asp-action="CreateBrand" method="post" style="display:grid; gap:8px;">
                    @Html.AntiForgeryToken()
                    <label>Thêm hãng xe mới</label>
                    <input class="form-control" name="brandName" placeholder="VD: Mazda" required />
                    <button type="submit" class="btn">Tạo hãng xe</button>
                </form>

                <form asp-action="CreateVehicleType" method="post" style="display:grid; gap:8px;">
                    @Html.AntiForgeryToken()
                    <label>Thêm loại xe mới</label>
                    <input class="form-control" name="typeName" placeholder="VD: Coupe" required />
                    <button type="submit" class="btn">Tạo loại xe</button>
                </form>

                <form asp-action="CreateAmenity" method="post" style="display:grid; gap:8px;">
                    @Html.AntiForgeryToken()
                    <label>Thêm tiện nghi mới</label>
                    <input class="form-control" name="amenityName" placeholder="VD: Cảm biến lùi" required />
                    <button type="submit" class="btn">Tạo tiện nghi</button>
                </form>
            </div>
            <div class="small" style="margin-top:10px;">Sau khi tạo xong danh mục, dùng form bên dưới để thêm xe mới.</div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Bước 2 - Thêm xe mới</div>
        <div class="panel-body">
            <form id="addVehicleForm" asp-action="AddVehicle" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OwnerId" value="0" />
                <div class="form-grid">
                    <div><label>Tên xe</label><input class="form-control" name="VehicleName" required /></div>
                    <div><label>Biển số</label><input class="form-control" name="LicensePlate" required /></div>
                    <div>
                        <label>Hãng xe</label>
                        <select name="BrandId" required>
                            <option value="">-- Chọn --</option>
                            @foreach (var b in Model.Brands)
                            {
                                <option value="@b.BrandId">@b.BrandName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Loại xe</label>
                        <select name="TypeId" required>
                            <option value="">-- Chọn --</option>
                            @foreach (var t in Model.Types)
                            {
                                <option value="@t.TypeId">@t.TypeName</option>
                            }
                        </select>
                    </div>
                    <div><label>Số chỗ</label><input class="form-control" name="Seats" type="number" min="2" max="60" value="4" required /></div>
                    <div>
                        <label>Hộp số</label>
                        <select name="Transmission" required>
                            <option value="Auto">Auto</option>
                            <option value="Manual">Manual</option>
                        </select>
                    </div>
                    <div>
                        <label>Nhiên liệu</label>
                        <select name="FuelType" required>
                            <option value="Gas">Xăng</option>
                            <option value="Diesel">Dầu</option>
                        </select>
                    </div>
                    <div><label>Giá/ngày</label><input class="form-control" name="PricePerDay" type="number" step="1" min="1" required /></div>
                    <div>
                        <label>Trạng thái</label>
                        <select name="Status">
                            <option value="AVAILABLE">AVAILABLE</option>
                            <option value="MAINTENANCE">MAINTENANCE</option>
                        </select>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <label>Tiện nghi (có thể chọn nhiều)</label>
                        @if (Model.AmenityOptions.Any())
                        {
                            <div class="amenity-grid">
                                @foreach (var amenity in Model.AmenityOptions)
                                {
                                    <label class="amenity-chip">
                                        <input type="checkbox" name="SelectedAmenities" value="@amenity.Code" />
                                        <span>@amenity.Name</span>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="small">Chưa có tiện nghi nào. Hãy tạo tiện nghi ở Bước 1.</div>
                        }
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <label>Ảnh xe (mỗi URL một dòng)</label>
                        <textarea id="imageUrls" name="ImageUrls" rows="3"></textarea>
                        <div style="margin-top: 8px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <input id="vehicleImageFiles" type="file" accept=".jpg,.jpeg,.png,.webp" multiple />
                            <button id="uploadVehicleImagesButton" type="button" class="btn">Tải ảnh từ máy</button>
                            <span class="small">Upload xong hệ thống sẽ tự thêm URL vào ô trên.</span>
                        </div>
                    </div>
                </div>
                <div style="margin-top:10px;">
                    <button type="submit" class="btn btn-primary">Thêm xe</button>
                </div>
            </form>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Danh sách xe</div>
        <div class="panel-body">
            @if (!Model.Vehicles.Any())
            {
                <div class="empty">Chưa có xe nào hiển thị cho admin.</div>
            }
            else
            {
                <table>
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên xe</th>
                        <th>Hãng/Loại</th>
                        <th>Giá/ngày</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in Model.Vehicles.OrderByDescending(x => x.VehicleId).Take(100))
                    {
                        <tr>
                            <td>#@v.VehicleId</td>
                            <td>@v.VehicleName</td>
                            <td>@v.BrandName / @v.TypeName</td>
                            <td>@v.PricePerDay.ToString("N0") VND</td>
                            <td>@v.Status</td>
                            <td>
                                <div class="actions">
                                    <a class="btn" asp-action="EditVehicle" asp-route-vehicleId="@v.VehicleId">Sửa</a>
                                    <button type="button" class="btn" onclick="openVehicleHeatmap(@v.VehicleId, '@v.VehicleName.Replace("'", "\\'")')">Lịch thuê</button>
                                    <form asp-action="DeleteVehicle" method="post" style="display:inline;" onsubmit="return confirm('Xóa xe này? Hành động sẽ ẩn xe khỏi hệ thống thuê.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="vehicleId" value="@v.VehicleId" />
                                        <button type="submit" class="btn btn-danger">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="small" style="margin-top:8px;">Đang hiển thị tối đa 100 xe mới nhất.</div>
            }
        </div>
    </div>
</div>

<div id="vehicleHeatmapModal" class="heatmap-modal" aria-hidden="true">
    <div class="heatmap-backdrop" onclick="closeVehicleHeatmap()"></div>
    <div class="heatmap-dialog" role="dialog" aria-modal="true" aria-labelledby="heatmapTitle">
        <div class="heatmap-header">
            <h3 id="heatmapTitle">Lịch hợp đồng xe</h3>
            <button type="button" class="heatmap-close" onclick="closeVehicleHeatmap()">Đóng</button>
        </div>
        <div class="heatmap-body">
            <div id="heatmapSummary" class="heatmap-empty">Đang tải dữ liệu...</div>
            <div class="heatmap-filter">
                <label for="heatmapYearSelect">Lọc theo năm</label>
                <select id="heatmapYearSelect" class="form-control">
                    <option value="2026">2026</option>
                </select>
            </div>
            <div class="heatmap-legend">
                <div class="legend-item"><span class="legend-color" style="background: rgba(239, 68, 68, 0.22);"></span><span>Ngày có hợp đồng</span></div>
                <div class="legend-item"><span class="legend-color" style="background: rgba(234, 179, 8, 0.28);"></span><span>Ngày bảo dưỡng (+1 sau thuê)</span></div>
                <div class="legend-item"><span class="legend-color" style="background: rgba(34, 197, 94, 0.16);"></span><span>Ngày trống</span></div>
            </div>
            <div id="heatmapCalendar" class="calendar-wrap"></div>
        </div>
    </div>
</div>

<script>
    const heatmapModal = document.getElementById('vehicleHeatmapModal');
    const heatmapTitle = document.getElementById('heatmapTitle');
    const heatmapSummary = document.getElementById('heatmapSummary');
    const heatmapYearSelect = document.getElementById('heatmapYearSelect');
    const heatmapCalendar = document.getElementById('heatmapCalendar');
    const defaultHeatmapYear = 2026;
    let heatmapState = {
        rentedKeys: new Set(),
        maintenanceKeys: new Set(),
        years: [defaultHeatmapYear]
    };

    function parseLocalDate(dateStr) {
        const [y, m, d] = (dateStr || '').split('-').map(Number);
        if (!y || !m || !d) {
            return null;
        }

        const dt = new Date(y, m - 1, d);
        dt.setHours(0, 0, 0, 0);
        return dt;
    }

    function formatDateKey(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function enumerateRangeDays(startDate, endDate) {
        const days = [];
        let cursor = new Date(startDate);
        while (cursor <= endDate) {
            days.push(new Date(cursor));
            cursor.setDate(cursor.getDate() + 1);
        }
        return days;
    }

    function closeVehicleHeatmap() {
        if (!heatmapModal) {
            return;
        }

        heatmapModal.classList.remove('open');
        heatmapModal.setAttribute('aria-hidden', 'true');
    }

    async function openVehicleHeatmap(vehicleId, vehicleName) {
        if (!heatmapModal || !heatmapTitle || !heatmapSummary || !heatmapCalendar || !heatmapYearSelect) {
            return;
        }

        heatmapModal.classList.add('open');
        heatmapModal.setAttribute('aria-hidden', 'false');
        heatmapTitle.textContent = `Lịch hợp đồng xe #${vehicleId} - ${vehicleName}`;
        heatmapSummary.textContent = 'Đang tải dữ liệu...';
        heatmapCalendar.innerHTML = '';
        heatmapYearSelect.innerHTML = `<option value="${defaultHeatmapYear}">${defaultHeatmapYear}</option>`;
        heatmapYearSelect.value = String(defaultHeatmapYear);

        try {
            const response = await fetch(`/Admin/VehicleSchedule?vehicleId=${vehicleId}`);
            const payload = await response.json();

            if (!response.ok) {
                heatmapSummary.textContent = payload?.error || 'Không thể tải lịch thuê xe.';
                return;
            }

            const ranges = Array.isArray(payload?.ranges) ? payload.ranges : [];
            renderVehicleHeatmap(ranges, defaultHeatmapYear);
        } catch {
            heatmapSummary.textContent = 'Không thể tải lịch thuê xe lúc này.';
        }
    }

    function renderVehicleHeatmap(ranges, initialYear) {
        const rentedKeys = new Set();
        const maintenanceKeys = new Set();
        const years = new Set([defaultHeatmapYear]);

        ranges.forEach(range => {
            const start = parseLocalDate(range.startDate);
            const end = parseLocalDate(range.endDate);
            if (!start || !end || start > end) {
                return;
            }

            enumerateRangeDays(start, end).forEach(day => rentedKeys.add(formatDateKey(day)));
            enumerateRangeDays(start, end).forEach(day => years.add(day.getFullYear()));

            const maintenanceDay = new Date(end);
            maintenanceDay.setDate(maintenanceDay.getDate() + 1);
            maintenanceKeys.add(formatDateKey(maintenanceDay));
            years.add(maintenanceDay.getFullYear());
        });

        heatmapState = {
            rentedKeys,
            maintenanceKeys,
            years: Array.from(years).sort((a, b) => a - b)
        };

        populateHeatmapYearFilter(initialYear);
        renderVehicleHeatmapByYear(Number(heatmapYearSelect?.value || defaultHeatmapYear));
    }

    function populateHeatmapYearFilter(selectedYear) {
        if (!heatmapYearSelect) {
            return;
        }

        const years = heatmapState.years.length > 0 ? heatmapState.years : [defaultHeatmapYear];
        heatmapYearSelect.innerHTML = years
            .map(year => `<option value="${year}">${year}</option>`)
            .join('');

        const targetYear = years.includes(selectedYear) ? selectedYear : (years.includes(defaultHeatmapYear) ? defaultHeatmapYear : years[0]);
        heatmapYearSelect.value = String(targetYear);
    }

    function countDaysForYear(dayKeys, year) {
        const prefix = `${year}-`;
        let count = 0;
        for (const key of dayKeys) {
            if (key.startsWith(prefix)) {
                count += 1;
            }
        }

        return count;
    }

    function renderVehicleHeatmapByYear(year) {
        if (!heatmapCalendar || !heatmapSummary) {
            return;
        }

        heatmapCalendar.innerHTML = '';

        const rentedCount = countDaysForYear(heatmapState.rentedKeys, year);
        const maintenanceCount = countDaysForYear(heatmapState.maintenanceKeys, year);
        if (rentedCount === 0 && maintenanceCount === 0) {
            heatmapSummary.textContent = `Năm ${year}: chưa có hợp đồng. Đang hiển thị lịch trống mặc định.`;
        } else {
            heatmapSummary.textContent = `Năm ${year}: ${rentedCount} ngày có hợp đồng, ${maintenanceCount} ngày bảo dưỡng (+1).`;
        }

        for (let month = 0; month < 12; month += 1) {
            heatmapCalendar.appendChild(buildMonthCalendar(year, month, heatmapState.rentedKeys, heatmapState.maintenanceKeys));
        }
    }

    function buildMonthCalendar(year, month, rentedKeys, maintenanceKeys) {
        const monthEl = document.createElement('div');
        monthEl.className = 'calendar-month';

        const header = document.createElement('div');
        header.className = 'calendar-month-head';
        const title = document.createElement('span');
        title.textContent = new Date(year, month, 1).toLocaleDateString('vi-VN', { month: 'long', year: 'numeric' });
        header.appendChild(title);
        monthEl.appendChild(header);

        const grid = document.createElement('div');
        grid.className = 'calendar-grid';
        ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'].forEach(dayName => {
            const dayHead = document.createElement('div');
            dayHead.className = 'calendar-cell calendar-head';
            dayHead.textContent = dayName;
            grid.appendChild(dayHead);
        });

        const firstDay = new Date(year, month, 1);
        const startDate = new Date(firstDay);
        startDate.setDate(startDate.getDate() - firstDay.getDay());

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let i = 0; i < 42; i++) {
            const current = new Date(startDate);
            current.setDate(startDate.getDate() + i);
            const key = formatDateKey(current);

            const cell = document.createElement('div');
            cell.className = 'calendar-cell';
            cell.textContent = String(current.getDate());

            if (current.getMonth() !== month) {
                cell.classList.add('day-other');
            } else if (maintenanceKeys.has(key)) {
                cell.classList.add('day-maintenance');
                cell.title = `${key}: Bảo dưỡng (+1)`;
            } else if (rentedKeys.has(key)) {
                cell.classList.add('day-rented');
                cell.title = `${key}: Đã có hợp đồng`;
            } else {
                cell.classList.add('day-free');
                cell.title = `${key}: Trống`;
            }

            if (formatDateKey(today) === key && current.getMonth() === month) {
                cell.classList.add('day-today');
            }

            grid.appendChild(cell);
        }

        monthEl.appendChild(grid);
        return monthEl;
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeVehicleHeatmap();
        }
    });

    heatmapYearSelect?.addEventListener('change', function (event) {
        const selectedYear = Number(event.target?.value || defaultHeatmapYear);
        renderVehicleHeatmapByYear(selectedYear);
    });

    async function uploadVehicleImages() {
        const form = document.getElementById('addVehicleForm');
        const fileInput = document.getElementById('vehicleImageFiles');
        const button = document.getElementById('uploadVehicleImagesButton');
        const imageUrls = document.getElementById('imageUrls');

        if (!form || !fileInput || !button || !imageUrls) {
            return;
        }

        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Vui lòng chọn ít nhất 1 ảnh trước khi tải lên.');
            return;
        }

        const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
        if (!tokenInput) {
            alert('Thiếu anti-forgery token. Vui lòng tải lại trang.');
            return;
        }

        const payload = new FormData();
        payload.append('__RequestVerificationToken', tokenInput.value);

        for (const file of fileInput.files) {
            payload.append('files', file);
        }

        button.disabled = true;
        button.textContent = 'Đang tải...';

        try {
            const response = await fetch('/Admin/UploadVehicleImages', {
                method: 'POST',
                body: payload
            });

            const data = await response.json();
            if (!response.ok) {
                alert(data.error || 'Tải ảnh thất bại.');
                return;
            }

            const urls = Array.isArray(data.urls) ? data.urls : [];
            if (urls.length === 0) {
                alert('Không có URL ảnh nào được trả về.');
                return;
            }

            const current = imageUrls.value?.trim();
            const merged = [current, ...urls].filter(Boolean).join('\n');
            imageUrls.value = merged;
            fileInput.value = '';
        } catch {
            alert('Không thể tải ảnh lúc này. Vui lòng thử lại.');
        } finally {
            button.disabled = false;
            button.textContent = 'Tải ảnh từ máy';
        }
    }

    document.getElementById('uploadVehicleImagesButton')?.addEventListener('click', uploadVehicleImages);
</script>
