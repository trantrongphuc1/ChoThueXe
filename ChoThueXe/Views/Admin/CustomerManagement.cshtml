@model ChoThueXe.Models.Portal.AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
    var customerKeywordFilter = (ViewData["CustomerKeywordFilter"] as string) ?? string.Empty;
}

<style>
    .admin-wrap { max-width: 1280px; margin: 24px auto; padding: 0 16px; }
    .admin-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
    .admin-header h1 { margin: 0; font-size: 28px; }
    .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .summary-box { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: var(--bg-secondary); }
    .summary-box .label { color: var(--text-secondary); font-size: 12px; }
    .summary-box .value { font-size: 20px; font-weight: 700; }
    .panel { border: 1px solid var(--border); border-radius: 12px; background: var(--bg-secondary); margin-bottom: 16px; overflow: hidden; }
    .panel-head { padding: 12px 14px; border-bottom: 1px solid var(--border); font-weight: 700; }
    .panel-body { padding: 12px 14px; }
    .empty { color: var(--text-secondary); }
    table { width: 100%; border-collapse: collapse; }
    th, td { border-bottom: 1px solid var(--border); padding: 8px; text-align: left; vertical-align: top; }
    th { color: var(--text-secondary); font-size: 12px; text-transform: uppercase; }
    .actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .btn { border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-primary); border-radius: 8px; padding: 7px 10px; cursor: pointer; }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-danger { background: #b91c1c; border-color: #b91c1c; color: #fff; }
    .btn-success { background: #15803d; border-color: #15803d; color: #fff; }
    .small { font-size: 12px; color: var(--text-secondary); }
    .alert { border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; border: 1px solid transparent; }
    .alert-success { background: var(--success-light); border-color: var(--success); color: #14532d; }
    .alert-danger { background: var(--error-light); border-color: var(--error); color: #7f1d1d; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
    .form-control, select { width: 100%; border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-primary); border-radius: 8px; padding: 8px 10px; }
    .table-pagination { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
    .page-btn { min-width: 34px; text-align: center; }
    .page-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 16px;
    }
    .modal-backdrop.show { display: flex; }
    .modal-card {
        width: min(680px, 100%);
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-secondary);
        overflow: hidden;
    }
    .modal-head {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        font-weight: 700;
    }
    .modal-body { padding: 14px; }
</style>

<div class="admin-wrap">
    <div class="admin-header">
        <h1>Quản lý khách hàng</h1>
        <a class="btn" href="/Home">Về trang chủ</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="summary">
        <div class="summary-box"><div class="label">Giấy tờ chờ duyệt</div><div class="value">@Model.PendingDocuments.Count</div></div>
        <div class="summary-box"><div class="label">Người dùng chờ đối chiếu</div><div class="value">@Model.PendingVerifications.Count</div></div>
        <div class="summary-box"><div class="label">Yêu cầu đổi hồ sơ</div><div class="value">@Model.PendingProfileUpdates.Count</div></div>
        <div class="summary-box"><div class="label">Tin nhắn hỗ trợ</div><div class="value">@Model.Messages.Count</div></div>
        <div class="summary-box"><div class="label">Tổng account</div><div class="value">@Model.Accounts.Count</div></div>
    </div>

    <div class="panel">
        <div class="panel-head">Tìm kiếm khách hàng</div>
        <div class="panel-body">
            <form asp-action="CustomerManagement" method="get" class="form-grid">
                <div>
                    <label>Tìm theo tên / email / SĐT / role / ID</label>
                    <input class="form-control" type="text" name="customerQ" value="@customerKeywordFilter" placeholder="VD: Nguyen Van A, customer@gmail.com, CUSTOMER" />
                </div>
                <div style="display:flex; gap:8px; align-items:end;">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    <a asp-action="CustomerManagement" class="btn">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
            <span>CRUD tài khoản</span>
            <button type="button" class="btn btn-primary" id="openCreateAccountModal">Tạo tài khoản mới</button>
        </div>
        <div class="panel-body">
            @if (!Model.Accounts.Any())
            {
                <div class="empty">Không có account nào.</div>
            }
            else
            {
                <table id="accountsTable" class="js-paged-table" data-pager-id="accountsPager" data-page-size="10">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Role</th>
                        <th>Hợp đồng</th>
                        <th>Tổng đã trả</th>
                        <th>Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var account in Model.Accounts)
                    {
                        <tr>
                            <td>#@account.UserId</td>
                            <td>@account.FullName</td>
                            <td>@account.Email</td>
                            <td>@account.Phone</td>
                            <td>@account.RoleName</td>
                            <td>@account.ContractCount</td>
                            <td>@account.TotalPaid.ToString("N0") VND</td>
                            <td>
                                <div class="actions">
                                    <button
                                        type="button"
                                        class="btn btn-success js-open-account-edit"
                                        data-user-id="@account.UserId"
                                        data-full-name="@account.FullName"
                                        data-email="@account.Email"
                                        data-phone="@account.Phone"
                                        data-role-name="@account.RoleName">
                                        Sửa
                                    </button>
                                    <form asp-action="DeleteAccount" method="post" onsubmit="return confirm('Xóa account này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@account.UserId" />
                                        <button type="submit" class="btn btn-danger">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div id="accountsPager" class="table-pagination"></div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Duyệt từng giấy tờ</div>
        <div class="panel-body">
            @if (!Model.PendingDocuments.Any())
            {
                <div class="empty">Không có giấy tờ chờ duyệt.</div>
            }
            else
            {
                <table id="documentsTable" class="js-paged-table" data-pager-id="documentsPager" data-page-size="10">
                    <thead>
                    <tr>
                        <th>Document</th>
                        <th>User</th>
                        <th>Loại</th>
                        <th>File</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model.PendingDocuments)
                    {
                        <tr>
                            <td>#@d.DocumentId</td>
                            <td>@d.UserId - @d.FullName</td>
                            <td>@d.DocType</td>
                            <td><a href="@d.FileUrl" target="_blank" rel="noopener">Xem file</a></td>
                            <td>@d.Status</td>
                            <td>
                                <form asp-action="ApproveDocument" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="documentId" value="@d.DocumentId" />
                                    <button type="submit" class="btn btn-success">Duyệt giấy tờ</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div id="documentsPager" class="table-pagination"></div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Đối chiếu CCCD và bằng lái</div>
        <div class="panel-body">
            @if (!Model.PendingVerifications.Any())
            {
                <div class="empty">Không có hồ sơ cần đối chiếu.</div>
            }
            else
            {
                <table id="verificationsTable" class="js-paged-table" data-pager-id="verificationsPager" data-page-size="10">
                    <thead>
                    <tr>
                        <th>User</th>
                        <th>CCCD</th>
                        <th>Bằng lái</th>
                        <th>Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in Model.PendingVerifications)
                    {
                        <tr>
                            <td>@v.UserId - @v.FullName</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(v.CccdFileUrl))
                                {
                                    <a href="@v.CccdFileUrl" target="_blank" rel="noopener">Xem CCCD</a>
                                    <div class="small">DocId: @v.CccdDocumentId</div>
                                }
                                else
                                {
                                    <span class="small">Chưa có</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(v.DriverLicenseFileUrl))
                                {
                                    <a href="@v.DriverLicenseFileUrl" target="_blank" rel="noopener">Xem bằng lái</a>
                                    <div class="small">DocId: @v.DriverLicenseDocumentId</div>
                                }
                                else
                                {
                                    <span class="small">Chưa có</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <form asp-action="ReviewDocuments" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="UserId" value="@v.UserId" />
                                        <input type="hidden" name="IsMatched" value="true" />
                                        <button type="submit" class="btn btn-success">Khớp (Duyệt)</button>
                                    </form>
                                    <form asp-action="ReviewDocuments" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="UserId" value="@v.UserId" />
                                        <input type="hidden" name="IsMatched" value="false" />
                                        <button type="submit" class="btn btn-danger">Không khớp (Từ chối)</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div id="verificationsPager" class="table-pagination"></div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Duyệt yêu cầu cập nhật hồ sơ</div>
        <div class="panel-body">
            @if (!Model.PendingProfileUpdates.Any())
            {
                <div class="empty">Không có yêu cầu cập nhật hồ sơ.</div>
            }
            else
            {
                <table id="profileUpdatesTable" class="js-paged-table" data-pager-id="profileUpdatesPager" data-page-size="10">
                    <thead>
                    <tr>
                        <th>User</th>
                        <th>Hiện tại</th>
                        <th>Yêu cầu mới</th>
                        <th>Thời gian</th>
                        <th>Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.PendingProfileUpdates)
                    {
                        <tr>
                            <td>@p.UserId</td>
                            <td>@p.CurrentFullName - @p.CurrentPhone</td>
                            <td>@p.RequestedFullName - @p.RequestedPhone</td>
                            <td>@p.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="actions">
                                    <form asp-action="ReviewProfileUpdate" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RequestId" value="@p.RequestId" />
                                        <input type="hidden" name="IsApproved" value="true" />
                                        <button type="submit" class="btn btn-success">Duyệt</button>
                                    </form>
                                    <form asp-action="ReviewProfileUpdate" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RequestId" value="@p.RequestId" />
                                        <input type="hidden" name="IsApproved" value="false" />
                                        <button type="submit" class="btn btn-danger">Từ chối</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div id="profileUpdatesPager" class="table-pagination"></div>
            }
        </div>
    </div>
</div>

<div id="createAccountModal" class="modal-backdrop" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="createAccountTitle">
        <div class="modal-head">
            <span id="createAccountTitle">Tạo tài khoản mới</span>
            <button type="button" class="btn" id="closeCreateAccountModal">Đóng</button>
        </div>
        <div class="modal-body">
            <form asp-action="CreateAccount" method="post" id="createAccountForm" style="display:grid; gap:10px;">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div>
                        <label>Họ tên</label>
                        <input class="form-control" name="FullName" required />
                    </div>
                    <div>
                        <label>Email</label>
                        <input class="form-control" type="email" name="Email" required />
                    </div>
                    <div>
                        <label>Số điện thoại</label>
                        <input class="form-control" name="Phone" />
                    </div>
                    <div>
                        <label>Role</label>
                        <select name="RoleName">
                            <option value="CUSTOMER">CUSTOMER</option>
                            <option value="EMPLOYEE">EMPLOYEE</option>
                            <option value="ADMIN">ADMIN</option>
                        </select>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <label>Mật khẩu (để trống = 123456Aa!)</label>
                        <input class="form-control" type="text" name="Password" />
                    </div>
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn-primary">Tạo account</button>
                    <button type="button" class="btn" id="cancelCreateAccountModal">Hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="accountEditModal" class="modal-backdrop" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="accountEditTitle">
        <div class="modal-head">
            <span id="accountEditTitle">Sửa tài khoản khách hàng</span>
            <button type="button" class="btn" id="closeAccountEditModal">Đóng</button>
        </div>
        <div class="modal-body">
            <form asp-action="UpdateAccount" method="post" id="accountEditForm" style="display:grid; gap:10px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" id="editUserId" />
                <div class="form-grid">
                    <div>
                        <label>Họ tên</label>
                        <input class="form-control" name="FullName" id="editFullName" required />
                    </div>
                    <div>
                        <label>Email</label>
                        <input class="form-control" type="email" name="Email" id="editEmail" required />
                    </div>
                    <div>
                        <label>Số điện thoại</label>
                        <input class="form-control" name="Phone" id="editPhone" />
                    </div>
                    <div>
                        <label>Role</label>
                        <select name="RoleName" id="editRoleName">
                            <option value="CUSTOMER">CUSTOMER</option>
                            <option value="EMPLOYEE">EMPLOYEE</option>
                            <option value="ADMIN">ADMIN</option>
                        </select>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <label>Mật khẩu mới (để trống nếu giữ nguyên)</label>
                        <input class="form-control" name="Password" id="editPassword" />
                    </div>
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                    <button type="button" class="btn" id="cancelAccountEditModal">Hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const defaultRowsPerPage = 10;

        function paginateTable(table) {
            const pagerId = table.getAttribute('data-pager-id');
            if (!pagerId) {
                return;
            }

            const rowsPerPage = Number(table.getAttribute('data-page-size')) || defaultRowsPerPage;

            const pager = document.getElementById(pagerId);
            const body = table.querySelector('tbody');
            if (!pager || !body) {
                return;
            }

            const rows = Array.from(body.querySelectorAll('tr'));
            if (rows.length <= rowsPerPage) {
                pager.innerHTML = '';
                return;
            }

            const totalPages = Math.ceil(rows.length / rowsPerPage);

            function renderPage(pageIndex) {
                rows.forEach((row, idx) => {
                    const start = (pageIndex - 1) * rowsPerPage;
                    const end = start + rowsPerPage;
                    row.style.display = idx >= start && idx < end ? '' : 'none';
                });

                Array.from(pager.querySelectorAll('.page-btn')).forEach(btn => {
                    const isActive = Number(btn.getAttribute('data-page')) === pageIndex;
                    btn.classList.toggle('active', isActive);
                });
            }

            pager.innerHTML = '';
            for (let page = 1; page <= totalPages; page++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn page-btn';
                btn.textContent = String(page);
                btn.setAttribute('data-page', String(page));
                btn.addEventListener('click', () => renderPage(page));
                pager.appendChild(btn);
            }

            renderPage(1);
        }

        const createModal = document.getElementById('createAccountModal');
        const openCreateBtn = document.getElementById('openCreateAccountModal');
        const closeCreateBtn = document.getElementById('closeCreateAccountModal');
        const cancelCreateBtn = document.getElementById('cancelCreateAccountModal');

        const modal = document.getElementById('accountEditModal');
        const closeBtn = document.getElementById('closeAccountEditModal');
        const cancelBtn = document.getElementById('cancelAccountEditModal');
        const editUserId = document.getElementById('editUserId');
        const editFullName = document.getElementById('editFullName');
        const editEmail = document.getElementById('editEmail');
        const editPhone = document.getElementById('editPhone');
        const editRoleName = document.getElementById('editRoleName');
        const editPassword = document.getElementById('editPassword');

        function closeModal() {
            if (!modal) {
                return;
            }

            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
        }

        function closeCreateModal() {
            if (!createModal) {
                return;
            }

            createModal.classList.remove('show');
            createModal.setAttribute('aria-hidden', 'true');
        }

        function openCreateModal() {
            if (!createModal) {
                return;
            }

            createModal.classList.add('show');
            createModal.setAttribute('aria-hidden', 'false');
        }

        function openModal(button) {
            if (!modal || !editUserId || !editFullName || !editEmail || !editPhone || !editRoleName || !editPassword) {
                return;
            }

            editUserId.value = button.getAttribute('data-user-id') || '';
            editFullName.value = button.getAttribute('data-full-name') || '';
            editEmail.value = button.getAttribute('data-email') || '';
            editPhone.value = button.getAttribute('data-phone') || '';
            editRoleName.value = button.getAttribute('data-role-name') || 'CUSTOMER';
            editPassword.value = '';

            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
        }

        document.querySelectorAll('.js-open-account-edit').forEach(button => {
            button.addEventListener('click', () => openModal(button));
        });

        closeBtn?.addEventListener('click', closeModal);
        cancelBtn?.addEventListener('click', closeModal);
        openCreateBtn?.addEventListener('click', openCreateModal);
        closeCreateBtn?.addEventListener('click', closeCreateModal);
        cancelCreateBtn?.addEventListener('click', closeCreateModal);

        modal?.addEventListener('click', (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });

        createModal?.addEventListener('click', (event) => {
            if (event.target === createModal) {
                closeCreateModal();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeModal();
                closeCreateModal();
            }
        });

        document.querySelectorAll('.js-paged-table').forEach(table => paginateTable(table));
    })();
</script>
